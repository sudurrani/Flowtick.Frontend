			}
		  },
		  {
			id: 2,
			code: "TSK-102",
			title: "Create login page UI",
			type: {
			  icon: "bi bi-brush-fill",
			  iconCSS: 'style="color:#0d6efd"'
			},
			priority: "Medium",
			assignee: {
