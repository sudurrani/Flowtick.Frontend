	function formatToISO(dateStr) {
		if (!dateStr) return null;
		let parts = dateStr.split('-'); // ["01", "05", "2026"]
		return `${parts[2]}-${parts[1]}-${parts[0]}`; // "2026-05-01"
	}

	function createTask(taskType = null) {

		if (!customValidateForm('backlogTaskForm')) {
		   return; // stop execution
		}
		var inputJSON = {
			"title": null,
			"assigneeId": loginUserID,
			"reporterId": loginUserID,
			"reviewerId": loginUserID,
			"statusId": 1,
			"typeId": null,
			"parentId": null
		};
		inputJSON.title = $("#childWorkTitle").val().trim();
		inputJSON.typeId = $("#childTaskTypeID").data("id");

		let url = `flowtick/project/${projectId}/tasks`;
		apiRequest({
			url: url,
			type: 'POST',
			data: inputJSON,
			callBack: createTaskCallBack,
			//| Below are used to pass to the callback for condition purposes
			taskType: taskType,
			parentId: inputJSON.parentId
		});
	}
	var createTaskCallBack = function (response, options) {
		if (response.request.status === 201) {
			successToastr($("#taskTitle").val(), 'Task');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function getSprintStatuses() {
		apiRequest({
			url: 'flowtick/sprint/statuses',
			type: 'GET',
			data: {},
			callBack: getSprintStatusesCallBack
		});
	}

	var getSprintStatusesCallBack = function (response) {
		if (response.request.status === 200) {

			var statuses = response.data; //  array

			var dropdown = $("#statusId");
			dropdown.empty();
			dropdown.append('<option selected disabled>Select status</option>');

			$.each(statuses, function (index, status) {
				var option = `<option  value="${status.id}">${status.description}</option>`;
				dropdown.append(option);
			});
		}
		else {
				errorExtractor(response);
		}
	};

	function createSprint(){
		if (customValidateForm('createSprintForm')) {
			var inputJSON = getFormDataAsJSONObject('createSprintForm');
			// convert dates
			inputJSON.startDate = formatToISO(inputJSON.startDate);
			inputJSON.endDate = formatToISO(inputJSON.endDate);
			//console.log(inputJSON);

			let url = `flowtick/project/${projectId}/sprints`;
			apiRequest({
				url: url,
				type: 'POST',
				data: inputJSON,
				callBack: createSprintCallBack
			});

		}
	}
	var createSprintCallBack = function (response) {
		if (response.request.status === 201) {
			successToastr("Saved successfully", 'Sprint');
			$('#createSprintModal').modal('hide');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function getSprintBacklog() {
			let url = `flowtick/project/${projectId}/backlog`;
		apiRequest({
			url: url,
			type: 'GET',
			data: {},
			callBack: getSprintBacklogCallBack
		});
	}
	var getSprintBacklogCallBack = function (response) {
		if (response.request.status === 200) {

			sprintBacklogArray = response.data; // your array
			//console.log(sprintBacklogArray);
			renderSprintsBacklog();
		}
		else {
			errorExtractor(response);
		}
	};
	function addTaskToSprint(taskId , sprintId){
		let url = `flowtick/tasks/${taskId}/sprint/${sprintId}`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: addTaskToSprintCallBack
			});
	}
	var addTaskToSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Assigned successfully", 'Sprint');
		    getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};
	function activateSprint(sprintId){
		let url = `flowtick/sprints/${sprintId}/active`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: activateSprintCallBack
			});
	}
	var activateSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Activated successfully", 'Sprint');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function completeSprint(sprintId){
		let url = `flowtick/sprints/${sprintId}/complete`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: completeSprintCallBack
			});
	}
	var completeSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Completed successfully", 'Sprint');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};
</script>