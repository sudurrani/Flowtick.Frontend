			  colorCode: "#198754"
			},
			status: {
			  id: 2,
			  name: "In Progress"
			}
		  }
		]
	  },

	  {
		sprintName: "Sprint 2",
		startDate: "2026-01-15",
		endDate: "2026-01-28",
		tasks: [
		  {
			id: 3,
			code: "TSK-201",
			title: "Implement authentication",
			type: {
			  icon: "bi bi-shield-lock-fill",
			  iconCSS: 'style="color:#dc3545"'
			},
			priority: "Medium",
			assignee: {
			  name: "Ahmed Raza",
			  colorCode: "#fd7e14"
			},
			status: {
			  id: 3,
			  name: "Review"
