	function trackSprint(sel){
	  if(sel.value){
		notsprint=Math.max(0,notsprint-1);
		document.getElementById('bl-notsprint').textContent=notsprint;
		sel.style.borderColor='var(--pt)';
		sel.style.color='var(--pt)';
		sel.style.fontWeight='600';
	  }
	}
		// Filter  dropdown
	$(document).on('keyup', '.seach-user-dropdown', function (e) {
		e.stopImmediatePropagation();
		let value = $(this).val().toLowerCase();

		let dropdown = $(this).closest('.flowtick-dropdown');

		dropdown.find('.dropdown-item').each(function () {
			$(this).toggle(
				$(this).find('.user-name').text().toLowerCase().includes(value)
			);
		});
	});

			// handle click for assignee in in sprints
	$(document).on("click", ".sprint-asignee-user-list .dropdown-item", function () {
	
		let userId = $(this).data("id");
		let username = $(this).data("name");
		let backgrounColor = $(this).find(".profile-image").attr("style");

		let avatar = `<div class="av av-mn" data-id="${userId}" style="${backgrounColor}">${getInitials(username)}</div>`;
		let dropdown = $(this).closest(".dropdown");
		dropdown.find(".sprint-selected-assignee").html(`${avatar} <span class="user-name ms-2">${username}</span> `);
		
		const selectedTasId = dropdown.closest("tr").attr("data-task-id");
		updateTaskAssignee(selectedTasId, userId);

	});

	function getSprintStatuses() {
		apiRequest({
			url: 'flowtick/sprint/statuses',
			type: 'GET',
			data: {},
			callBack: getSprintStatusesCallBack
		});
	}

	var getSprintStatusesCallBack = function (response) {
		if (response.request.status === 200) {

		    _sprintStatusesArray = response.data; //  array
		}
		else {
				errorExtractor(response);
		}
	};

	function formatToISO(dateStr) {
		if (!dateStr) return null;
		let parts = dateStr.split('-'); // ["01", "05", "2026"]
		return `${parts[2]}-${parts[1]}-${parts[0]}`; // "2026-05-01"
	}

	function getTaskTypes() {
		apiRequest({
			url: 'flowtick/task/types',
			type: 'GET',
			data: {},
			callBack: getTaskTypesCallBack
		});
	}
	var getTaskTypesCallBack = function (response) {
		if (response.request.status === 200) {

			_taskTypes = response.data; // your array
			 loadTaskTypeDropdown();
		}
		else {
			errorExtractor(response);
		}
	};
	function loadTaskTypeDropdown() {

		var $taskTypeSelect = $('#tasktypeId');
		$taskTypeSelect.append(
			`<option value="">Select Task Type</option>`
		);

		$.each(_taskTypes, function (index, item) {

			var selected = item.id == 3 ? 'selected' : '';
			var option = `
				<option value="${item.id}" ${selected}>
					${item.description}
				</option>
			`;
			$taskTypeSelect.append(option);
		});
	}
	function getProjectSprints() {
			let url = `flowtick/project/${projectId}/sprints`;
		apiRequest({
			url: url,
			type: 'GET',
			data: {},
			callBack: getProjectSprintsCallBack
		});
	}
	var getProjectSprintsCallBack = function (response) {
		if (response.request.status === 200) {

			_projectSprintArray = response.data;
			//console.log(_projectSprintArray);
		}
		else {
			errorExtractor(response);
		}
	};

	function getSprintBacklog() {
			let url = `flowtick/project/${projectId}/backlog`;
		apiRequest({
			url: url,
			type: 'GET',
			data: {},
			callBack: getSprintBacklogCallBack
		});
	}
	var getSprintBacklogCallBack = function (response) {
		if (response.request.status === 200) {

			sprintBacklogArray = response.data; // your array
			//console.log(sprintBacklogArray);
			renderSprintsBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function renderSprintsBacklog() {
		//debugger;
	  var $container = $('.sprint-container');
	  $container.empty();
	  var sprintArray = sprintBacklogArray.sprints;
	  var backlogArray = sprintBacklogArray.backlog;
	 // console.log(sprintArray);
	 // console.log(backlogArray);

	  // load ProjectMember Dropdown 
		//console.log(_projectMember);
		var assigneeDropdownItem = "";
		$.each(_projectMember, function (i, member) {
			assigneeDropdownItem += `
						 <li class="dropdown-item" data-name="${member.user}" data-id="${member.userId}">
								 <div class="assignee-avatar-sm profile-image" style="background:${member.colorCode}">${getInitials(member.user)} </div>
								<span class="user-name ms-2">${member.user}</span>
						 </li>
			`;
		});

	  $.each(sprintArray, function (sIndex, sprint) {

			let totalTasks = sprint.taskStatusCount.all;
			let doneTasks = sprint.taskStatusCount.done;

			let progressPercentage = 0;
				progressPercentage = ((doneTasks / totalTasks) * 100).toFixed(0);

			// Dates
			let today = new Date();
			let startDate = new Date(sprint.startDate);
			let endDate = new Date(sprint.endDate);

			// Duration (start → end)
			let durationDays = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24));
			if (durationDays < 0) durationDays = 0;

			// Days left (today → end)
			let daysLeft = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
			if (daysLeft < 0) daysLeft = 0;

			// Starts in (today → start)
			let startsIn = Math.ceil((startDate - today) / (1000 * 60 * 60 * 24));
			if (startsIn < 0) startsIn = 0;

		   var sprintHtmlBaseOnStatus = "";
		   if (sprint.status.description === "Planned") {

				let workloadHtml = '';
				let totalMember = sprint.assigneeCount.length;
				$.each(sprint.assigneeCount, function(index, item) {

					workloadHtml += `
					   <div class="wl-item"><span class="wl-av wl-av-mn">${getInitials(item.name)}</span><span class="wl-name">${item.name}</span><div class="wl-bar-wrap"><div class="wl-bar" style="width:${item.workLoad}%;background:#6366f1"></div></div><span class="wl-count" style="color:#6366f1">${item.count}t</span></div>
					`;
				});


				sprintHtmlBaseOnStatus = `
					  <div class="section mt-3">
						  <div class="sprint-hd planned-sprint" onclick="toggle(this,'${sprint.name}-body','chev-${sprint.id}')">
							<div class="hd-left">
							  <i class="ti ti-chevron-down chevron" id="chev-${sprint.id}" aria-hidden="true"></i>
							  <span class="sprint-name planned-col"> ${sprint.name}</span>
							  <span class="pill pill-date-p"><i class="ti ti-calendar" aria-hidden="true" style="font-size:10px"></i>${sprint.startDate} - ${sprint.endDate}</span>
							  <span class="pill pill-planned"><i class="ti ti-clock-pause" aria-hidden="true" style="font-size:10px"></i>${sprint.status.description}</span>
							  <span class="pill pill-tasks"><i class="ti ti-list-check" aria-hidden="true" style="font-size:10px"></i>${sprint.taskStatusCount.all} tasks</span>
							</div>
							<div class="hd-right">
							  <button class="btn-action btn-activate activate-sprint-btn" data-sprint-id="${sprint.id}"><i class="ti ti-player-play" aria-hidden="true" style="font-size:13px"></i>Activate</button>
							</div>
						  </div>
						  <div id="${sprint.name}-body"style="display:none">
							<div class="meta-strip">
							  <div class="meta-row">
								<div class="meta-stat"><i class="ti ti-calendar-event meta-stat-icon" style="color:#6366f1" aria-hidden="true"></i><span class="meta-stat-label">Starts in:</span><span class="meta-stat-val">${startsIn} days</span></div>
								<div class="meta-divider"></div>
								<div class="meta-stat"><i class="ti ti-list meta-stat-icon" style="color:#6366f1" aria-hidden="true"></i><span class="meta-stat-label">Tasks planned:</span><span class="meta-stat-val"> ${sprint.taskStatusCount.all}</span></div>
								<div class="meta-divider"></div>
								<div class="meta-stat"><i class="ti ti-users meta-stat-icon" style="color:#6366f1" aria-hidden="true"></i><span class="meta-stat-label">Members:</span><span class="meta-stat-val">${totalMember}</span></div>
							  </div>
							  <div class="progress-row">
								<span class="prog-label">Task progress</span>
								<div class="progress-bar"><div class="progress-fill pf-planned" style="width:${progressPercentage}%"></div></div>
								<span class="prog-pct pct-planned">${progressPercentage}%</span>
							  </div>
							  <div class="workload-row">
								<span class="wl-title">Planned workload</span>
									${workloadHtml}
							  </div>
							</div>
							<div class="tbl-wrap">
							<table>
								<thead>
								<tr>
								<th style="width:44%">Title</th>
								<th>Priority</th>
								<th>Assignee</th>
								<th>Status</th></tr></thead>
								<tbody class="sprint-task-tbody">

								</tbody>
							</table>
							</div>
						  </div>
						</div>
				`;
			}
			else if (sprint.status.description === "Active") {

					let workloadHtml = '';
					let totalMember = sprint.assigneeCount.length;
				$.each(sprint.assigneeCount, function(index, item) {

					workloadHtml += `
						<div class="wl-item"><span class="wl-av wl-av-mn">${getInitials(item.name)}</span><span class="wl-name">${item.name}</span><div class="wl-bar-wrap"><div class="wl-bar" style="width:${item.workLoad}%"></div></div><span class="wl-count">${item.count}t</span></div>
						
					`;
				});

			  sprintHtmlBaseOnStatus = `
					<div class="section mt-2">
					  <div class="sprint-hd active-sprint" onclick="toggle(this,'${sprint.name}-body','chev-${sprint.id}')">
						<div class="hd-left">
						  <i class="ti ti-chevron-down chevron " id="chev-${sprint.id}" aria-hidden="true"></i>
						  <span class="sprint-name active-col">${sprint.name}</span>
						  <span class="pill pill-date"><i class="ti ti-calendar" aria-hidden="true" style="font-size:10px"></i>${sprint.startDate} - ${sprint.endDate}</span>
						  <span class="pill pill-active"><i class="ti ti-circle-filled" aria-hidden="true" style="font-size:8px"></i>${sprint.status.description}</span>
						  <span class="pill pill-days"><i class="ti ti-clock" aria-hidden="true" style="font-size:10px"></i><span id="days-left">${daysLeft}</span> days left</span>
						  <span class="pill pill-tasks"><i class="ti ti-list-check" aria-hidden="true" style="font-size:10px"></i>${sprint.taskStatusCount.done} / ${sprint.taskStatusCount.all} done</span>
						</div>
						<div class="hd-right" >
						  <button class="btn-action btn-complete complete-sprint-btn" data-sprint-id="${sprint.id}"><i class="ti ti-circle-check" aria-hidden="true" style="font-size:13px"></i>Complete</button>
						</div>
					  </div>
					  <div id="${sprint.name}-body" style="display:none">
						<div class="meta-strip">
						  <div class="meta-row">
							<div class="meta-stat"><i class="ti ti-clock meta-stat-icon" aria-hidden="true"></i><span class="meta-stat-label">Days left:</span><span class="meta-stat-val" id="days-val">${daysLeft} of ${durationDays}</span></div>
							<div class="meta-divider"></div>
							<div class="meta-stat"><i class="ti ti-list-check meta-stat-icon" aria-hidden="true"></i><span class="meta-stat-label">Tasks:</span><span class="meta-stat-val">${sprint.taskStatusCount.done} of ${sprint.taskStatusCount.all} done</span></div>
							<div class="meta-divider"></div>
							<div class="meta-divider"></div>
							<div class="meta-stat"><i class="ti ti-users meta-stat-icon" aria-hidden="true"></i><span class="meta-stat-label">Members:</span><span class="meta-stat-val">${totalMember}</span></div>
						  </div>
						  <div class="progress-row">
							<span class="prog-label">Task progress</span>
							<div class="progress-bar"><div class="progress-fill pf-active" style="width:${progressPercentage}%"></div></div>
							<span class="prog-pct pct-active">${progressPercentage}%</span>
						  </div>
						  <div class="workload-row">
							<span class="wl-title">Workload</span>
								  ${workloadHtml}
						  </div>
						</div>
						<div class="tbl-wrap">
							<table>
								<thead>
								<tr>
								<th style="width:44%">Title</th>
								<th>Priority</th>
								<th>Assignee</th>
								<th>Status</th></tr></thead>
								<tbody class="sprint-task-tbody">

								</tbody>
							</table>
						</div>
					  </div>
					</div>
				`;
			}
			else if (sprint.status.description === "Completed") {
				let workloadHtml = '';
				let totalMember = sprint.assigneeCount.length;
				$.each(sprint.assigneeCount, function(index, item) {

					workloadHtml += `
					   <div class="wl-item"><span class="wl-av wl-av-mn">${getInitials(item.name)}</span><span class="wl-name">${item.name}</span><div class="wl-bar-wrap"><div class="wl-bar" style="width:${item.workLoad}%;background:#10b981"></div></div><span class="wl-count" style="color:#10b981">${item.count}t</span></div>
					`;
				});
				sprintHtmlBaseOnStatus = `
				 <div class="section completed mt-3">
					  <div class="sprint-hd completed-sprint" onclick="toggle(this,'${sprint.name}-body','chev-${sprint.id}')">
						<div class="hd-left">
						  <i class="ti ti-chevron-down chevron" id="chev-${sprint.id}" aria-hidden="true"></i>
						  <span class="sprint-name completed-col">${sprint.name}</span>
						  <span class="pill pill-date-c"><i class="ti ti-calendar" aria-hidden="true" style="font-size:10px"></i>${sprint.startDate} - ${sprint.endDate}</span>
						  <span class="pill pill-completed"><i class="ti ti-circle-check" aria-hidden="true" style="font-size:10px"></i>${sprint.status.description}</span>
						  <span class="pill pill-tasks"><i class="ti ti-list-check" aria-hidden="true" style="font-size:10px"></i>${sprint.taskStatusCount.done} / ${sprint.taskStatusCount.all} tasks</span>
						</div>
						<div class="hd-right" onclick="event.stopPropagation()">
						  <button class="btn-action btn-reopen"><i class="ti ti-refresh" aria-hidden="true" style="font-size:13px"></i>Reopen</button>
						</div>
					  </div>
					  <div id="${sprint.name}-body" style="display:none">
						<div class="completed-banner">
						  <i class="ti ti-circle-check" aria-hidden="true" style="font-size:15px"></i>
						  Sprint completed on  ${sprint.endDate} — ${sprint.taskStatusCount.done} / ${sprint.taskStatusCount.all} tasks done ·
						</div>
						<div class="meta-strip">
						  <div class="meta-row">
							<div class="meta-stat"><i class="ti ti-calendar-check meta-stat-icon" style="color:#10b981" aria-hidden="true"></i><span class="meta-stat-label">Duration:</span><span class="meta-stat-val"> ${durationDays} days</span></div>
							<div class="meta-divider"></div>
							<div class="meta-stat"><i class="ti ti-list-check meta-stat-icon" style="color:#10b981" aria-hidden="true"></i><span class="meta-stat-label">Tasks:</span><span class="meta-stat-val">${sprint.taskStatusCount.done} of ${sprint.taskStatusCount.all} done</span></div>
							<div class="meta-divider"></div>
							<div class="meta-stat"><i class="ti ti-users meta-stat-icon" style="color:#10b981" aria-hidden="true"></i><span class="meta-stat-label">Members:</span><span class="meta-stat-val">  ${totalMember}</span></div>
						  </div>
						  <div class="progress-row">
							<span class="prog-label">Completion</span>
							<div class="progress-bar"><div class="progress-fill pf-completed" style="width:${progressPercentage}%"></div></div>
							<span class="prog-pct pct-completed">${progressPercentage}%</span>
						  </div>
						  <div class="workload-row">
							<span class="wl-title">Workload</span>
							  ${workloadHtml}
						  </div>
						</div>
						<div class="tbl-wrap">
						 <table>
								<thead>
								<tr>
								<th style="width:44%">Title</th>
								<th>Priority</th>
								<th>Assignee</th>
								<th>Status</th></tr></thead>
								<tbody class="sprint-task-tbody">

								</tbody>
							</table>
						</div>
					  </div>
				  </div>
				`;
			}

		var sprintHtml = `${sprintHtmlBaseOnStatus}`;

		// Convert string → jQuery element
		var $sprintElement = $(sprintHtml);

		// Get tbody INSIDE this sprint
		var $tbody = $sprintElement.find('.sprint-task-tbody');

		//  LOOP 2: TASK LOOP (INSIDE TBODY)
		$.each(sprint.tasks, function (tIndex, task) {
			//debugger;
			var statusHtml = "";
		   if (task.status === "ToDo") {
				statusHtml = `<span class="badge b-todo"> <i class="ti ti-clock-hour-4" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		   else if (task.status === "In Progress") {
			   statusHtml = `<span class="badge b-prog"> <i class="ti ti-progress" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		   else if (task.status === "Review") {
			   statusHtml = `<span class="badge b-review"><i class="ti ti-eye" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		   else{
			statusHtml = `<span class="badge b-done"><i class="ti ti-check" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		  var tr = `
					<tr  data-task-id="${task.id}">
						<td><div class="task-cell"><i class="${task.type.icon}"${task.type.iconCSS} aria-hidden="true"></i><span class="task-code">${task.code}</span><span class="task-name">${task.title}</span></div></td>
						<td><div class="prio-cell"><span class="prio-dot med"></span><span class="prio-text">Medium</span></div></td>
						<td>
						<div class="assign-cell">
							<div class="dropdown mt-2">
								<div class="dropdown-toggle no-caret" data-bs-toggle="dropdown">
									<div class="sprint-selected-assignee d-flex align-items-center" style="cursor:pointer">
										 <div class="av av-mn profile-image" data-user-id="${task.assignee.Id}" style="background:${task.assignee.colorCode}" >
										 ${getInitials(task.assignee.name)} </div>
										 <span class="user-name ms-2 ">${task.assignee.name}</span>
									</div>
								</div>
								<div class="dropdown-menu flowtick-dropdown">
									<div class="flowtick-dropdown-search">
										<i class="bi bi-search"></i>
										<input type="text" class="seach-user-dropdown" placeholder="Search users">
									</div>
									<ul class="dropdown-list sprint-asignee-user-list">
										${assigneeDropdownItem}
									</ul>
								</div>
							</div>
						</div>
						</td>

						<td>${statusHtml}</td>
					</tr>
		  `;

		  //  Append TR directly into THIS sprint tbody
		  $tbody.append(tr);
		});

		// Append whole sprint block into container
		$container.append($sprintElement);
	  });

	  // loop on backlog start
		// Get backlog tbody
	  var $backlogTbody = $("#backlogTableTbody");
		$backlogTbody.empty();
		let totalItemInBacklog = backlogArray.length;
		$('#bl-count').text(totalItemInBacklog + ' items');
		$('#bl-notsprint').text(totalItemInBacklog);
		console.log(totalItemInBacklog);
		var sprintList = "";
		$.each(_projectSprintArray, function (i, sprint) {
			sprintList += `
				<option class="add-sprint-item" value="${sprint.id}">${sprint.name}</option>
			`;
		});
	  $.each(backlogArray, function (tIndex, task) {
		 var statusHtml = "";
		   if (task.status === "ToDo") {
				statusHtml = `<span class="badge b-todo"> <i class="ti ti-clock-hour-4" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		   else if (task.status === "In Progress") {
			   statusHtml = `<span class="badge b-prog"> <i class="ti ti-progress" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		else if (task.status === "Review") {
			   statusHtml = `<span class="badge b-review"><i class="ti ti-eye" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		   else{
			statusHtml = `<span class="badge b-done"><i class="ti ti-check" aria-hidden="true" style="font-size:10px"></i>${task.status}</span>`
		   }
		  var tr = `
			<tr>
							<td><div class="task-cell"><i class="${task.type.icon}"${task.type.iconCSS} aria-hidden="true"></i><span class="task-code">${task.code}</span><span class="task-name">${task.title}</span></div></td>
							<td><div class="prio-cell"><span class="prio-dot med"></span><span class="prio-text">Medium</span></div></td>
							<td><div class="assign-cell"><span class="av av-mn">${getInitials(task.assignee)}</span>${task.assignee}</div></td>
							<td>${statusHtml}</td>
							<td><select class="sprint-sel" onchange="addTaskToSprint(this)" data-task-id="${task.id}" >
								  <option value="">Select sprint</option>
									${sprintList}
							   </select>
							</td>
			</tr>
		  `;

		  $backlogTbody.append(tr);
		});
	}
	function addTaskToSprint(selectEl){
	   const sprintId = selectEl.value;
	   const taskId = selectEl.dataset.taskId;

		let url = `flowtick/tasks/${taskId}/sprint/${sprintId}`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: addTaskToSprintCallBack
			});
	}
	var addTaskToSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Assigned successfully", 'Sprint');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};
		function activateSprint(sprintId){
		let url = `flowtick/sprints/${sprintId}/active`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: activateSprintCallBack
			});
	}
	var activateSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Activated successfully", 'Sprint');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function completeSprint(sprintId){
		let url = `flowtick/sprints/${sprintId}/complete`;
			apiRequest({
				url: url,
				type: 'PUT',
				data: {},
				callBack: completeSprintCallBack
			});
	}
	var completeSprintCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Completed successfully", 'Sprint');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function addTask() {

		if (!customValidateForm('createTaskBacklogForm')) {
		   return; // stop execution
		}
		var inputJSON = {
			"title": $('#taskInput').val(),
			"assigneeId": loginUserID,
			"reporterId": loginUserID,
			"reviewerId": loginUserID,
			"statusId": 1,
			"typeId": $('#tasktypeId').val(),
			"parentId": null
		};

		let url = `flowtick/project/${projectId}/tasks`;
		apiRequest({
			url: url,
			type: 'POST',
			data: inputJSON,
			callBack: createTaskCallBack
			
		});
	}
	var createTaskCallBack = function (response) {
		if (response.request.status === 201) {
			successToastr($("#taskInput").val(), 'Task');
			$('#taskInput').val('');
		    $('#tasktypeId').val(3);
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};

	function getProjectMembers() {
		let url = `flowtick/project/${projectId}/members`;
		apiRequest({
			url: url,
			type: 'GET',
			data: {},
			callBack: getProjectMembersCallBack
		});
	}
	var getProjectMembersCallBack = function (response) {
		if (response.request.status === 200) {

			_projectMember = response.data
		}
		else {
			_projectMember = [];
			errorExtractor(response);
		}
	};

	function updateTaskAssignee(taskId, selectedAssigneeId) {
		let url = `flowtick/tasks/${taskId}/assignee`;
		apiRequest({
			url: url,
			type: 'PUT',
			data: {
				"assigneeId": selectedAssigneeId
			},
			callBack: updateTaskAssigneeCallBack
		});
	}
	var updateTaskAssigneeCallBack = function (response) {
		if (response.request.status === 204) {
			successToastr("Assigned successfully", 'Assignee');
			getSprintBacklog();
		}
		else {
			errorExtractor(response);
		}
	};
</script>


