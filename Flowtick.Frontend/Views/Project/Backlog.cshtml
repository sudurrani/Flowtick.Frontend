	//   tr.className='new-row';
	//   tr.innerHTML=`<td><div class="task-cell"><i class="ti ${icon} t-icon" aria-hidden="true"></i><span class="task-code">TSK-101</span><span class="task-name">TI-${n++} ${name}</span></div></td><td><div class="prio-cell"><span class="prio-dot med"></span><span class="prio-text">Medium</span></div></td><td><div class="assign-cell"><span class="av av-mn">MN</span>M. Nauman</div></td><td><span class="badge b-todo">ToDo</span></td><td><select class="sprint-sel" onchange="trackSprint(this)"><option value="">Select sprint</option><option>Sprint — 2</option><option>Sprint — 3</option></select></td>`;
