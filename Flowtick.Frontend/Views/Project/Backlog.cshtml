		endDate: "2026-01-14",
		tasks: [
		  {
			id: 1,
			code: "TSK-101",
			title: "Setup project structure",
			type: {
			  icon: "bi bi-check-circle-fill",
			  iconCSS: 'style="color:#28a745"'
			},
			priority: "Medium",
			assignee: {
			  name: "Ali Khan",
			  colorCode: "#6f42c1"
			},
			status: {
			  id: 1,
