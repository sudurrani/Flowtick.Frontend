	$(document).on("click", ".activate-sprint-btn", function () {
		var sprintId = $(this).data("sprint-id");
		activateSprint(sprintId);
	});

	$(document).on("click", ".complete-sprint-btn", function () {
		var sprintId = $(this).data("sprint-id");
		completeSprint(sprintId);
	});
	// days left calculation
	(function(){
	  const end=new Date('2026-05-31');
	  const today=new Date('2026-05-07');
	  const diff=Math.ceil((end-today)/(1000*60*60*24));
	  const el=document.getElementById('days-left');
	  const el2=document.getElementById('days-val');
	  if(el)el.textContent=diff;
	  if(el2)el2.textContent=diff+' of 31';
	})();

	let n=7,count=3,notsprint=3;

	function toggle(hd,bodyId,chevId){
	  const body=document.getElementById(bodyId);
	  const chev=document.getElementById(chevId);
	  const closed=body.style.display==='none';
	  body.style.display=closed?'':'none';
	  chev.classList.toggle('open',closed);
	}

	function toggleAddRow(){
	  const row=document.getElementById('add-row');
	  const btn=document.getElementById('add-btn');
	  const vis=row.classList.contains('visible');
	  if(vis){row.classList.remove('visible');btn.classList.remove('active');document.getElementById('taskInput').value='';}
	  else{row.classList.add('visible');btn.classList.add('active');setTimeout(()=>document.getElementById('taskInput').focus(),50);}
	}

	// function addTask(){
	//   const inp=document.getElementById('taskInput');
	//   const type=document.getElementById('task-type').value;
	//   const name=inp.value.trim();
	//   if(!name)return;
	//   count++;notsprint++;
	//   document.getElementById('bl-count').textContent=count+' items';
