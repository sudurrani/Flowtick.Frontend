				  </table>
				</div>
			  </details>
			</div>
		  </div>
		`;

		// Convert string → jQuery element
		var $sprintElement = $(sprintHtml);

		// Get tbody INSIDE this sprint
		var $tbody = $sprintElement.find('.sprint-task-tbody');

		//  LOOP 2: TASK LOOP (INSIDE TBODY)
		$.each(sprint.tasks, function (tIndex, task) {
			//debugger;
		  var tr = `
			<tr data-id="${task.id}">
			  <td>
				<i class="bi bi-layout-text-window-reverse task-icon"style="color:#14b8a6"></i>
				<span class="task-no sub-task-detail"
					  onclick="getSubTaskById(${task.id});"
					  role="button">
				  TSK-101
				</span>
				<span class="child-task-title">${task.title}</span>
			  </td>
			  <td>
				<i class="bi bi-filter" style="color:#E06C00"></i> Medium
			  </td>
			  <td>
				<div class="dropdown">
				  <div class="dropdown-toggle no-caret" data-bs-toggle="dropdown">
					<div class="subtask-selected-assignee d-flex align-items-center">
					  <div class="assignee-avatar-sm"
						   style="background:#14b8a6">
						${getInitials(task.assignee)}
					  </div>
					  <span class="user-name ms-2">
						${task.assignee}
					  </span>
					</div>
				  </div>

				</div>
			  </td>

			  <td>
				<div class="dropdown">
				  <a class="text-decoration-none dropdown-toggle no-caret btn-task-subtask-status btn-create"
					 data-bs-toggle="dropdown"
					 data-id="">
					<span>${task.status}</span>
				  </a>
				</div>
			  </td>
			</tr>
		  `;

		  //  Append TR directly into THIS sprint tbody
		  $tbody.append(tr);
		});

		// Append whole sprint block into container
		$container.append($sprintElement);
	  });

	  // loop on backlog start
		// Get backlog tbody 
	  var $backlogTbody = $("#backlogTableTbody");
		$backlogTbody.empty();

		var sprintList = "";
		$.each(_projectSprintArray, function (i, sprint) {
			sprintList += `
				<li class="dropdown-item add-sprint-item"
					data-task-id=""
					data-sprint-id="${sprint.id}">
					 <span class="add-sprint-name ms-2">${sprint.name}</span>
				</li>
			`;
		});
	  $.each(backlogArray, function (tIndex, task) {
		  var tr = `
			<tr data-id="${task.id}">
			  <td>
				<i class="bi bi-layout-text-window-reverse task-icon"style="color:#14b8a6"></i>
				<span class="task-no sub-task-detail"
					  onclick="getSubTaskById(${task.id});"
					  role="button">
				  TSK-101
				</span>
				<span class="child-task-title">${task.title}</span>
			  </td>
			  <td>
				<i class="bi bi-filter" style="color:#E06C00"></i> Medium
			  </td>
			  <td>
				<div class="dropdown">
				  <div class="dropdown-toggle no-caret" data-bs-toggle="dropdown">
					<div class="subtask-selected-assignee d-flex align-items-center">
					  <div class="assignee-avatar-sm"
						   style="background:#14b8a6">
						${getInitials(task.assignee)}
					  </div>
					  <span class="user-name ms-2">
						${task.assignee}
					  </span>
					</div>
