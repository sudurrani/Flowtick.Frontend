<!DOCTYPE html>
<html lang="en">
<head>
    @{
        Layout = null;
    }
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/img/logo/flowtick-round.svg" type="image/x-icon">
    <title>Flowtick -  Forgot Password</title>
    <link href="~/layout/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/layout/css/bootstrap-icons.min.css" rel="stylesheet" />
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- jQuery -->
    <script src="~/layout/js/jquery-3.7.1.min.js"></script>
    <link href="~/lib/toastr/toastr.css" rel="stylesheet" />

    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />


    <script src="~/scripts/crypto-js.min.js"></script>
    <script src="~/lib/toastr/toastr.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <style>
       /*  :root {
            --primary-color: #2563eb;
            --secondary-color: #2563eb;
            --dark-orange: #1e40af;
            --light-orange: #dbeafe;
        } */

        :root {
            --primary-color: #0d9488;
            --primary-btn-bg: #0d9488;
            --primary-btn-fore: #fff;
            --primary-hover: #0f766e;
            --border-color: #e5e7eb;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            height: 100vh;
            padding: 0;
        }

        .row {
            height: 100%;
            margin: 0;
        }

        .left-section {
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            height: 100%;
        }

        .right-section {
            background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            color: white;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .right-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: pulse 15s infinite;
        }

        .right-section {
            flex: 1;
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .right-section::before {
                content: '';
                position: absolute;
                width: 500px;
                height: 500px;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 50%;
                top: -200px;
                right: -200px;
            }

            .right-section::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 50%;
                bottom: -100px;
                left: -100px;
            }
        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .form-container {
            width: 100%;
            max-width: 450px;
        }

        .info-container {
            width: 100%;
            max-width: 500px;
            position: relative;
            z-index: 1;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--primary-color);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 20px;
        }

        .logo-text {
            font-size: 24px;
            font-weight: 600;
            color: #111827;
        }

        .logo-icon i {
            font-size: 32px;
            color: white;
        }

        .logo-text h2 {
            color: #1f2937;
            font-weight: 700;
            margin: 0;
            font-size: 26px;
        }

        .logo-text p {
            color: #6b7280;
            margin: 5px 0 0 0;
            font-size: 13px;
        }

        .auth-title {
            color: #1f2937;
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 24px;
        }

        .auth-subtitle {
            color: #6b7280;
            margin-bottom: 30px;
            font-size: 14px;
            line-height: 1.5;
        }

        .icon-wrapper {
            text-align: center;
            margin-bottom: 5px;
        }

        .reset-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #dbeafe 0%, #93c5fd 100%);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            /* margin-bottom: 20px; */
        }

        .reset-icon i {
            font-size: 35px;
            color: var(--primary-color);
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            color: #374151;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-control {
            padding: 12px 15px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            outline: none;
        }

        .input-icon {
            position: relative;
        }

        .input-icon i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

        .input-icon .form-control {
            padding-right: 45px;
        }

        .btn-primary-custom {
            background: var(--primary-color);
            color: white;
            padding: 12px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            transition: all 0.3s;
            cursor: pointer;
        }
/* 
        .btn-primary-custom:hover {
            background: var(--dark-orange);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
        } */

        .back-to-login {
            text-align: center;
            margin-top: 25px;
        }

        .back-to-login a {
            color: var(--primary-color);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
        }

        .back-to-login a i {
            margin-right: 5px;
        }

        .back-to-login a:hover {
            text-decoration: underline;
        }

        .info-box {
            background: rgba(37, 99, 235, 0.1);
            border-left: 4px solid var(--primary-color);
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
        }

        .info-box-title {
            font-weight: 600;
            color: #1e40af;
            margin-bottom: 8px;
            font-size: 14px;
            display: flex;
            align-items: center;
        }

        .info-box-title i {
            margin-right: 8px;
            color: var(--primary-color);
        }

        .info-box-text {
            color: #1e3a8a;
            font-size: 13px;
            line-height: 1.5;
        }

        .info-title {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 18px;
            line-height: 1.2;
        }

        .info-description {
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 30px;
            opacity: 0.95;
        }

        .help-steps {
            background: rgba(255, 255, 255, 0.15);
            padding: 25px;
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .help-steps-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .step-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .step-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .step-number {
            background: rgba(255, 255, 255, 0.25);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-weight: 700;
            font-size: 18px;
            flex-shrink: 0;
        }

        .step-content {
            flex: 1;
        }

        .step-title {
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 15px;
        }

        .step-description {
            font-size: 13px;
            opacity: 0.9;
            line-height: 1.4;
        }

        .security-features {
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }

        .security-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .security-item i {
            margin-right: 10px;
            opacity: 0.9;
        }

        @@media (max-width: 768px) {
            .right-section {
                display: none;
            }
        }
    </style>
</head>
<body>
    @{
        @await Html.PartialAsync("~/Views/Shared/PartialViews/Common/_AjaxRequestLoaderPartialView.cshtml")
    }
    <div class="container-fluid">
        <div class="row">
            <!-- Left Section - Forgot Password Form -->
            <div class="col-lg-6 left-section">
                <div class="form-container">
                    <div class="logo-section">
                        <div class="logo">
                            <img src="/img/Logo/flowtick.svg" width="350" />
                        </div>
                        
                    </div>

                    <div class="icon-wrapper">
                        <div class="reset-icon">
                            <i class="fas fa-key"></i>
                        </div>
                    </div>

                    <h3 class="auth-title">Forgot Password?</h3>
                    <p class="auth-subtitle">No worries! Enter your email address and we'll send you instructions to reset your password.</p>

                    <form id="forgotForm">
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <div class="input-icon">
                                <input type="email" class="form-control" id="email" placeholder="Enter your registered email" required>
                                <i class="fas fa-envelope"></i>
                            </div>
                        </div>

                        <button type="button" class="btn-primary-custom" id="sendResetLinkBtn">
                            <i class="fas fa-paper-plane"></i> Send Reset Link
                        </button>
                    </form>

                    <div class="info-box">
                        <div class="info-box-title">
                            <i class="fas fa-info-circle"></i>
                            Important Information
                        </div>
                        <div class="info-box-text">
                            The reset link will be sent to your registered email address. Please check your spam folder if you don't receive it within 5 minutes. The link will expire in 24 hours for security purposes.
                        </div>
                    </div>

                    <div class="back-to-login">
                        <a href="/Auth/Login?key=yv15zWBkMQRyOJqOoT3v%2Fg%3D%3D">
                            <i class="fas fa-arrow-left"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Section - Info -->
            <div class="col-lg-6 right-section">
                <div class="info-container">
                    <div class="info-title">
                        Secure Password Recovery
                    </div>
                    <div class="info-description">
                        Your account security is our top priority. We use industry-standard encryption and security measures to protect your data and ensure a safe password reset process.
                    </div>

                    <div class="help-steps">
                        <div class="help-steps-title">How Password Reset Works</div>
                        
                        <div class="step-item">
                            <div class="step-number">1</div>
                            <div class="step-content">
                                <div class="step-title">Enter Your Email</div>
                                <div class="step-description">Provide the email address associated with your MediStock account</div>
                            </div>
                        </div>

                        <div class="step-item">
                            <div class="step-number">2</div>
                            <div class="step-content">
                                <div class="step-title">Check Your Inbox</div>
                                <div class="step-description">We'll send you a secure password reset link within minutes</div>
                            </div>
                        </div>

                        <div class="step-item">
                            <div class="step-number">3</div>
                            <div class="step-content">
                                <div class="step-title">Create New Password</div>
                                <div class="step-description">Click the link and set a strong new password for your account</div>
                            </div>
                        </div>

                        <div class="step-item">
                            <div class="step-number">4</div>
                            <div class="step-content">
                                <div class="step-title">Login Successfully</div>
                                <div class="step-description">Use your new password to access your account immediately</div>
                            </div>
                        </div>
                    </div>

                    <div class="security-features" hidden>
                        <div class="security-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>256-bit SSL Encryption</span>
                        </div>
                        <div class="security-item">
                            <i class="fas fa-lock"></i>
                            <span>Two-Factor Authentication Available</span>
                        </div>
                        <div class="security-item">
                            <i class="fas fa-user-shield"></i>
                            <span>Account Activity Monitoring</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/functionalityjs/common-script.js"></script>
</body>
</html>
<script>
    $(function () {
       $("#sendResetLinkBtn").click( function(){
           sendResetLink();
       })
    });

    function sendResetLink(){
      if (customValidateForm('forgotForm')) {

        $("#email").addClass("readonly").prop("disabled", true);
        $("#sendResetLinkBtn").addClass("readonly").prop("disabled", true);
        var inputJSON = getFormDataAsJSONObject('forgotForm');
     
        let url = `flowtick/auth/forgot-password`;
            apiRequest({
                url: url,
                type: 'POST',
                data: inputJSON,
                callBack: sendResetLinkCallBack
            });
       }
    }
    var sendResetLinkCallBack = function (response) {
        if (response.request.status === 200) {
            $('#email').val('');
           $("#email").removeClass("readonly").prop("disabled", false);
           $("#sendResetLinkBtn").removeClass("readonly").prop("disabled", false);
            successToastr("Send successfully", 'Reset Link');
           
        }
        else {
            errorExtractor(response);
           $('#email').val('');
           $("#email").removeClass("readonly").prop("disabled", false);
           $("#sendResetLinkBtn").removeClass("readonly").prop("disabled", false);
        }
    };
</script>
