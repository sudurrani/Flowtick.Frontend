@{
    ViewData["Title"] = "Project";
    Layout = "~/Views/Shared/_FlowtickLayout.cshtml";
}

<link href="~/css/board/project-board.css" rel="stylesheet" />

<style>

    /* ============================================================
       FLOWTICK — BOARD FILTER ROW STYLES
       File: board-filter.css
       Depends on: Bootstrap Icons CDN, board-header.css (for --ft-* vars)
       ============================================================ */

    /* ── Filter row shell ── */
    .ft-filter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 18px;
        background: var(--ft-bg-2);
        border-bottom: 0.5px solid var(--ft-border);
        gap: 8px;
        flex-wrap: wrap;
        position: relative;
     /*    z-index: 90; */
    }

    .ft-filter-row__left {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .ft-filter-row__right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    /* ── Filter dropdown wrapper ── */
    .ft-filter-dropdown {
        position: relative;
        display: inline-block;
    }

    /* ── Filter button (Assignee / Type / Priority) ── */
    .ft-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid var(--ft-border-md);
        border-radius: var(--ft-radius);
        background: var(--ft-bg);
        color: var(--ft-text-muted);
        font-size: 12px;
        font-weight: 500;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
        user-select: none;
        font-family: inherit;
    }

        .ft-filter-btn i {
            font-size: 13px;
        }

        .ft-filter-btn:hover,
        .ft-filter-btn--active {
            border-color: var(--ft-primary);
            color: var(--ft-primary);
            background: var(--ft-primary-light);
        }

    /* chevron rotation when open */
    .ft-filter-btn__chevron {
        font-size: 11px;
        opacity: 0.5;
        transition: transform 0.15s;
    }

    .ft-filter-btn--active .ft-filter-btn__chevron {
        transform: rotate(180deg);
    }

    /* count badge inside filter btn */
    .ft-filter-btn__count {
        background: var(--ft-primary);
        color: #fff;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        padding: 0 5px;
        line-height: 16px;
        min-width: 16px;
        text-align: center;
    }

    /* ── Sprint button (styled differently — teal pill) ── */
    .ft-filter-sprint-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid var(--ft-primary-border);
        border-radius: var(--ft-radius);
        background: var(--ft-primary-light);
        color: var(--ft-primary);
        font-size: 12px;
        font-weight: 600;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
        user-select: none;
        font-family: inherit;
    }

        .ft-filter-sprint-btn:hover {
            background: var(--ft-primary);
            color: #fff;
            border-color: var(--ft-primary);
        }

    /* ── Toggle (Only Title / My Review) ── */
    .ft-filter-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 0.5px solid var(--ft-border-md);
        border-radius: var(--ft-radius);
        background: var(--ft-bg);
        color: var(--ft-text-muted);
        font-size: 12px;
        padding: 5px 10px;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
        user-select: none;
    }

        .ft-filter-toggle i {
            font-size: 13px;
        }

        .ft-filter-toggle:hover {
            border-color: var(--ft-primary);
            color: var(--ft-primary);
        }

    /* Toggle checkbox box */
    .ft-filter-toggle__box {
        width: 13px;
        height: 13px;
        border-radius: 3px;
        border: 1.5px solid var(--ft-border-md);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
        color: transparent;
        transition: all 0.15s;
        flex-shrink: 0;
    }

    /* Toggle checked state */
    .ft-filter-toggle--checked {
        border-color: var(--ft-primary);
        color: var(--ft-primary);
        background: var(--ft-primary-light);
    }

        .ft-filter-toggle--checked .ft-filter-toggle__box {
            background: var(--ft-primary);
            border-color: var(--ft-primary);
            color: #fff;
        }

    /* ── Vertical divider ── */
    .ft-filter-divider {
        width: 1px;
        height: 18px;
        background: var(--ft-border-md);
        flex-shrink: 0;
    }

    /* ── Clear filters button ── */
    .ft-filter-clear-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11.5px;
        color: var(--ft-text-muted);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: var(--ft-radius);
        transition: all 0.15s;
        border: 0.5px solid transparent;
        background: transparent;
        font-family: inherit;
        white-space: nowrap;
    }

        .ft-filter-clear-btn:hover {
            color: var(--ft-danger);
            background: #fee2e2;
            border-color: #fca5a5;
        }

    /* ── Dropdown panel (shared) ── */
    .ft-dropdown-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        background: var(--ft-bg);
        border: 0.5px solid var(--ft-border-md);
        border-radius: var(--ft-radius-lg);
        padding: 5px;
        min-width: 175px;
        z-index: 250;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.09);
    }

    .ft-dropdown-panel--right {
        left: auto;
        right: 0;
    }

    /* Label inside panel */
    .ft-dropdown-panel__label {
        font-size: 10px;
        font-weight: 700;
        color: var(--ft-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 5px 9px 3px;
    }

    /* Section label (for Add dropdown) */
    .ft-dropdown-panel__section-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 700;
        color: var(--ft-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 5px 9px 3px;
    }

        .ft-dropdown-panel__section-label i {
            font-size: 12px;
        }

    /* Separator */
    .ft-dropdown-panel__separator {
        height: 0.5px;
        background: var(--ft-border);
        margin: 3px 0;
    }

    /* Dropdown item */
    .ft-dropdown-panel__item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 9px;
        border-radius: var(--ft-radius);
        cursor: pointer;
        font-size: 12.5px;
        color: var(--ft-text);
        transition: background 0.12s;
        user-select: none;
    }

        .ft-dropdown-panel__item:hover {
            background: var(--ft-bg-2);
        }

        .ft-dropdown-panel__item i {
            font-size: 14px;
            color: var(--ft-text-muted);
            flex-shrink: 0;
            width: 15px;
            text-align: center;
        }

    /* Selected item checkmark */
    .ft-dropdown-panel__checkmark {
        margin-left: auto;
        font-size: 13px;
        color: var(--ft-primary);
        width: auto !important;
    }

    /* Selected item highlight */
    .ft-dropdown-panel__item--selected {
        background: var(--ft-primary-light);
        color: var(--ft-primary);
    }

        .ft-dropdown-panel__item--selected i {
            color: var(--ft-primary);
        }

    /* Featured item (New Task / New Project) */
    .ft-dropdown-panel__item--featured {
        background: var(--ft-primary-light);
        border: 0.5px solid var(--ft-primary-border);
        border-radius: var(--ft-radius);
        margin: 2px 0;
    }

        .ft-dropdown-panel__item--featured:hover {
            background: var(--ft-primary-mid);
        }

        .ft-dropdown-panel__item--featured i:first-child {
            color: var(--ft-primary);
        }

        .ft-dropdown-panel__item--featured span {
            color: var(--ft-primary);
            font-weight: 600;
        }

    /* Member avatar inside dropdown */
    .ft-member-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    /* Sprint status labels */
    .ft-sprint-status {
        font-size: 10px;
        font-weight: 600;
        margin-left: 4px;
    }

    .ft-sprint-status--done {
        color: #10b981;
    }

    .ft-sprint-status--active {
        color: #0d9488;
    }

    .ft-sprint-status--planned {
        color: #6366f1;
    }

    /* ── Add button ── */
    .ft-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--ft-primary);
        color: #fff;
        border: none;
        border-radius: var(--ft-radius);
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
        white-space: nowrap;
        font-family: inherit;
    }

        .ft-add-btn:hover {
            background: var(--ft-primary-hover);
        }

    .ft-add-btn__sep {
        width: 1px;
        height: 14px;
        background: rgba(255, 255, 255, 0.3);
        margin: 0 2px;
    }

    /* ── Shared hidden ── */
    .ft-dropdown--hidden {
        display: none !important;
    }


</style>

