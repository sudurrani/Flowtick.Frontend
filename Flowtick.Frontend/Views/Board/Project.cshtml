                </div>

                <div class="ft-dropdown-panel__separator"></div>

                <!-- Project section -->
                <div class="ft-dropdown-panel__section-label">
                    <i class="bi bi-folder"></i> Project
                </div>
                <div class="ft-dropdown-panel__item ft-dropdown-panel__item--featured" id="ft-add-project" role="menuitem" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                    <i class="bi bi-folder-plus"></i>
                    <span>New Project</span>
                    <i class="bi bi-arrow-right" style="margin-left:auto;font-size:12px;color:var(--ft-primary)"></i>
                </div>
                <div class="ft-dropdown-panel__item" id="ft-add-sprint" role="menuitem">
                    <i class="bi bi-collection"></i> New Sprint
                </div>

            </div>
        </div><!-- /ft-add-dropdown-wrap -->
    </div><!-- /ft-filter-right -->

</div><!-- /ft-filter-row -->
