<!-- ============================================================
   Filter row html Start
     ============================================================ -->

<div class="ft-filter-row" id="ft-filter-row">

    <!-- LEFT: Filter controls -->
    <div class="ft-filter-row__left" id="ft-filter-left">

        <!-- Filter: Assignee -->
        <div class="ft-filter-dropdown" id="ft-filter-assignee-wrap">
            <button class="ft-filter-btn" id="ft-filter-assignee-btn" aria-haspopup="listbox" aria-expanded="false">
                <i class="bi bi-people"></i>
                Assignee
                <span class="ft-filter-btn__count ft-dropdown--hidden" id="ft-filter-assignee-count"></span>
                <i class="bi bi-chevron-down ft-filter-btn__chevron"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown--hidden" id="ft-filter-assignee-panel" role="listbox" aria-multiselectable="true">
                <div class="ft-dropdown-panel__label">Team members</div>
                @*     load dyanamic  *@
            </div>
        </div><!-- /ft-filter-assignee-wrap -->
        <!-- Filter: Task Type -->
        <div class="ft-filter-dropdown" id="ft-filter-type-wrap">
            <button class="ft-filter-btn" id="ft-filter-type-btn" aria-haspopup="listbox" aria-expanded="false">
                <i class="bi bi-funnel"></i>
                Type
                <span class="ft-filter-btn__count ft-dropdown--hidden" id="ft-filter-type-count"></span>
                <i class="bi bi-chevron-down ft-filter-btn__chevron"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown--hidden" id="ft-filter-type-panel" role="listbox" aria-multiselectable="true">
                <div class="ft-dropdown-panel__label">Task type</div>
               @*     load dyanamic  *@
            </div>
        </div><!-- /ft-filter-type-wrap -->
        <!-- Filter: Priority -->
        <div class="ft-filter-dropdown" id="ft-filter-priority-wrap">
            <button class="ft-filter-btn" id="ft-filter-priority-btn" aria-haspopup="listbox" aria-expanded="false">
                <i class="bi bi-bar-chart-steps"></i>
                Priority
                <span class="ft-filter-btn__count ft-dropdown--hidden" id="ft-filter-priority-count"></span>
                <i class="bi bi-chevron-down ft-filter-btn__chevron"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown--hidden" id="ft-filter-priority-panel" role="listbox" aria-multiselectable="true">
                <div class="ft-dropdown-panel__item" id="ft-priority-high" data-priority="high" role="option" aria-selected="false">
                    <i class="bi bi-arrow-up-circle-fill" style="color:#ef4444"></i> High
                </div>
                <div class="ft-dropdown-panel__item" id="ft-priority-medium" data-priority="medium" role="option" aria-selected="false">
                    <i class="bi bi-dash-circle-fill" style="color:#f59e0b"></i> Medium
                </div>
                <div class="ft-dropdown-panel__item" id="ft-priority-low" data-priority="low" role="option" aria-selected="false">
                    <i class="bi bi-arrow-down-circle-fill" style="color:#818cf8"></i> Low
                </div>
            </div>
        </div><!-- /ft-filter-priority-wrap -->

        <div class="ft-filter-divider" role="separator"></div>

        <!-- Toggle: Only Title -->
        <div class="ft-filter-toggle" id="ft-toggle-only-title" role="checkbox" aria-checked="false" tabindex="0">
            <i class="bi bi-type"></i>
            Only Title
            <span class="ft-filter-toggle__box"></span>
        </div>

        <!-- Toggle: My Review -->
        <div class="ft-filter-toggle" id="ft-toggle-my-review" role="checkbox" aria-checked="false" tabindex="0">
            <i class="bi bi-eye"></i>
            My Review
            <input type="checkbox" id="cbMyReview"  hidden/>
            <span class="ft-filter-toggle__box"></span>
        </div>

        <div class="ft-filter-divider" role="separator"></div>

        <!-- Sprint selector -->
        <div class="ft-filter-dropdown" id="ft-filter-sprint-wrap">
            <button class="ft-filter-sprint-btn" id="ft-filter-sprint-btn" data-sprint-id="0" data-sprint-name="No Sprint" aria-haspopup="listbox" aria-expanded="false" role="option">
                <i class="bi bi-collection"></i>
                <span id="ft-sprint-label">Select Sprint</span>
                <i class="bi bi-chevron-down" style="font-size:11px;opacity:.7"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown--hidden" id="ft-filter-sprint-panel" role="listbox">
                <div class="ft-dropdown-panel__label">Sprint</div>
@*                 <div class="ft-dropdown-panel__item" id="ft-sprint-all" role="option" data-sprint-id="0" data-sprint-status="all">
                    <i class="bi bi-grid-3x3-gap"></i> All sprints
                </div>
                <div class="ft-dropdown-panel__separator"></div> *@
               @*  <div class="ft-dropdown-panel__item" id="ft-sprint-1" data-sprint="sprint-1" role="option">
                    <i class="bi bi-check-circle-fill" style="color:#10b981"></i>
                    Sprint — 1
                    <span class="ft-sprint-status ft-sprint-status--done">Done</span>
                </div>
                <div class="ft-dropdown-panel__item ft-dropdown-panel__item--selected" id="ft-sprint-2" data-sprint="sprint-2" role="option" aria-selected="true">
                    <i class="bi bi-circle-fill" style="color:#0d9488;font-size:9px"></i>
                    Sprint — 2
                    <span class="ft-sprint-status ft-sprint-status--active">Active</span>
                    <i class="bi bi-check ft-dropdown-panel__checkmark"></i>
                </div>
                <div class="ft-dropdown-panel__item" id="ft-sprint-3" data-sprint="sprint-3" role="option">
                    <i class="bi bi-clock" style="color:#6366f1"></i>
                    Sprint — 3
                    <span class="ft-sprint-status ft-sprint-status--planned">Planned</span>
                </div> *@
            </div>
        </div><!-- /ft-filter-sprint-wrap -->
        <!-- Clear all filters -->
        <button class="ft-filter-clear-btn ft-dropdown--hidden" id="ft-filter-clear-btn">
            <i class="bi bi-x-circle"></i> Clear
        </button>

    </div><!-- /ft-filter-left -->
    <!-- RIGHT: Add button -->
    <div class="ft-filter-row__right" id="ft-filter-right">
        <div class="ft-filter-dropdown" id="ft-add-dropdown-wrap">
            <button class="ft-add-btn" id="ft-add-btn" aria-haspopup="menu" aria-expanded="false">
                <i class="bi bi-plus-lg"></i>
                Add
                <span class="ft-add-btn__sep"></span>
                <i class="bi bi-chevron-down" style="font-size:11px;opacity:.8"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown-panel--right ft-dropdown--hidden" id="ft-add-panel" role="menu" style="min-width:210px">

                <!-- Task section -->
                <div class="ft-dropdown-panel__section-label" >
                    <i class="bi bi-check2-square"></i> Task
                </div>
                <div class="ft-dropdown-panel__item ft-dropdown-panel__item--featured" id="ft-add-task" role="menuitem" onclick="openCreateTaskModal('Task')">
                    <i class="bi bi-card-list"></i>
                    <span>New Task</span>
                    <i class="bi bi-arrow-right" style="margin-left:auto;font-size:12px;color:var(--ft-primary)"></i>
                </div>
                <div class="ft-dropdown-panel__item" id="ft-add-bug" role="menuitem" onclick="openCreateTaskModal('Bug')">
                    <i class="bi bi-bug" style="color:#ef4444"></i> New Bug
                </div>
                <div class="ft-dropdown-panel__item" id="ft-add-story" role="menuitem" onclick="openCreateTaskModal('Story')">
                    <i class="bi bi-star" style="color:#f59e0b"></i> New Story
                </div>
                <div class="ft-dropdown-panel__item" id="ft-add-epic" role="menuitem" onclick="openCreateTaskModal('Epic')">
                    <i class="bi bi-lightning" style="color:#8b5cf6"></i> New Epic
                </div>

                <div class="ft-dropdown-panel__separator"></div>

                <!-- Project section -->
                <div class="ft-dropdown-panel__section-label">
                    <i class="bi bi-folder"></i> Project
                </div>
                <div class="ft-dropdown-panel__item ft-dropdown-panel__item--featured" id="ft-add-project" role="menuitem" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                    <i class="bi bi-folder-plus"></i>
                    <span>New Project</span>
                    <i class="bi bi-arrow-right" style="margin-left:auto;font-size:12px;color:var(--ft-primary)"></i>
                </div>
                <div class="ft-dropdown-panel__item" id="ft-add-sprint" role="menuitem">
                    <i class="bi bi-collection"></i> New Sprint
                </div>

            </div>
        </div><!-- /ft-add-dropdown-wrap -->
    </div><!-- /ft-filter-right -->

</div><!-- /ft-filter-row -->
<!-- Board Container -->
<div class="board-container">
    <div class="board-columns" id="boardColumns">
        <!-- Columns will be rendered here by jQuery -->
    </div>
</div>

@{
    @await Html.PartialAsync("~/Views/Shared/PartialViews/Board/_SprintConfirmationModalPartialView.cshtml")
    ;
}
@{
    @await Html.PartialAsync("~/Views/Shared/PartialViews/Board/_ProjectTaskModalPartialView.cshtml")
    ;
}

@{
    @await Html.PartialAsync("~/Views/Shared/PartialViews/Board/_createtaskmodalpartialview.cshtml")
    ;
}

<script src="~/layout/js/quill.js"></script>

<script src="~/js/functionalityjs/board/project-board.js"></script>
