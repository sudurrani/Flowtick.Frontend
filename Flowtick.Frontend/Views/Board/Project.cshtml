                <span class="ft-filter-btn__count ft-dropdown--hidden" id="ft-filter-type-count"></span>
                <i class="bi bi-chevron-down ft-filter-btn__chevron"></i>
            </button>
            <div class="ft-dropdown-panel ft-dropdown--hidden" id="ft-filter-type-panel" role="listbox" aria-multiselectable="true">
