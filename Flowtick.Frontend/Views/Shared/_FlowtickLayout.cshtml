@* Views/Shared/_Layout.cshtml - Add these in the appropriate sections *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Flowtick Project Management | A brand of BK-InfoTech</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/img/logo/logo.png" type="image/x-icon">

    <!-- Bootstrap CSS -->
    <link href="~/layout/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="~/layout/css/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Bootstrap Bundle JS -->
    <script src="~/layout/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="~/layout/js/jquery-3.7.1.min.js"></script>
    <link href="~/lib/toastr/toastr.css" rel="stylesheet" />

    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />


    <script src="~/scripts/crypto-js.min.js"></script>
    <script src="~/lib/toastr/toastr.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>

    <link href="~/layout/css/select2.min.css" rel="stylesheet" />


    <link href="~/layout/css/flowtick-layout.css" rel="stylesheet" />
	<link href="~/css/dashboard/flowtick-header.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        @await Html.PartialAsync("~/Views/Shared/PartialViews/Common/_AjaxRequestLoaderPartialView.cshtml")
    }
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="bi bi-app-indicator"></i>
                <span class="sidebar-brand-text">Project Board</span>
            </div>
            <button class="toggle-btn" id="toggleSidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="sidebar-nav">
            <div class="nav-item">
                <a href="#" class="nav-link  @(ViewContext.RouteData.Values["action"]?.ToString() == "Main" ? "active" : "")" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard"
                   onclick="redirectToAction('/Dashboard/Main?id=',0);">
                    <i class="bi bi-house-door"></i>
                    <span class="nav-link-text">Home</span>
                </a>
            </div>
            <div class="nav-item p-2">
                <label style="border-bottom:1px solid var(--primary-color)" class="w-100 pb-1">
                    Project(s)
                </label>
            </div>
            <div class="nav-item ps-3" id="sidebarProjects">
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Tasks" ? "active" : "")" data-bs-toggle="tooltip" data-bs-placement="right" title="Tasks">
                    <i class="bi bi-check-circle"></i>
                    <span class="nav-link-text">Tasks</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="right" title="Calendar">
                    <i class="bi bi-calendar-event"></i>
                    <span class="nav-link-text">Calendar</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="right" title="Reports">
                    <i class="bi bi-graph-up"></i>
                    <span class="nav-link-text">Reports</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="right" title="Team">
                    <i class="bi bi-people"></i>
                    <span class="nav-link-text">Team</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="/Timesheet/List" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "List" ? "active" : "")" data-bs-toggle="tooltip" data-bs-placement="right" title="Timesheet">
                    <i class="bi bi-graph-up"></i>
                    <span class="nav-link-text">Timesheet</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings">
                    <i class="bi bi-gear"></i>
                    <span class="nav-link-text">Settings</span>
                </a>
            </div>
        </div>
    </div>
    <!-- Sidebar -->

    <div class="main-content" id="mainContent">
        <!-- ============================================================
             FLOWTICK — BOARD HEADER ROW
             Standalone component. Include board-header.css + board-header.js
             ============================================================ -->

        <header class="ft-header" id="ft-header">

            <!-- LEFT: Breadcrumb navigation -->
            <div class="ft-header__left" id="ft-header-left">
                <nav class="ft-breadcrumb" id="ft-breadcrumb" aria-label="Breadcrumb">
                    <span class="ft-breadcrumb__link" id="ft-bc-projects">
                        <i class="bi bi-grid-3x3-gap"></i> Projects
                    </span>
                    <span class="ft-breadcrumb__sep">/</span>
                    <span class="ft-breadcrumb__project" id="ft-bc-project-name">Fophex-ERP</span>
                    <span class="ft-breadcrumb__sep">/</span>
                    <span class="ft-breadcrumb__current" id="ft-bc-current-page">Board</span>
                </nav>
                <span class="ft-header__board-badge" id="ft-board-badge">
                    <i class="bi bi-kanban"></i> Sprint Board
                </span>
            </div>

            <!-- RIGHT: Actions -->
            <div class="ft-header__right" id="ft-header-right">

                <!-- Search -->
                <div class="ft-search" id="ft-search-wrap">
                    <i class="bi bi-search ft-search__icon"></i>
                    <input type="text"
                           class="ft-search__input"
                           id="searchInput"
                           placeholder="Search tasks…"
                           autocomplete="off" />
                </div>

                <!-- View Toggle: Board / List / Backlog -->
                <div class="ft-view-toggle" id="ft-view-toggle" role="group" aria-label="View mode">
                    <button class="ft-view-toggle__btn ft-view-toggle__btn--active" id="ft-view-board" data-view="board" title="Board view" aria-label="Board view">
                        <i class="bi bi-kanban"></i>
                    </button>
                    <button class="ft-view-toggle__btn" id="ft-view-list" data-view="list" title="List view" aria-label="List view">
                        <i class="bi bi-list-ul"></i>
                    </button>
                    <button class="ft-view-toggle__btn" id="ft-view-backlog" data-view="backlog" title="Backlog view" aria-label="Backlog view">
                        <i class="bi bi-layout-text-sidebar"></i>
                    </button>
                </div>

                <!-- Notifications -->
                <button class="ft-header__icon-btn" id="ft-btn-notifications" title="Notifications" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="ft-notification-dot" id="ft-notification-dot"></span>
                </button>

                <!-- Settings -->
                <button class="ft-header__icon-btn" id="ft-btn-settings" title="Settings" aria-label="Settings">
                    <i class="bi bi-gear"></i>
                </button>

                <!-- Help -->
                <button class="ft-header__icon-btn" id="ft-btn-help" title="Help" aria-label="Help">
                    <i class="bi bi-question-circle"></i>
                </button>

                <!-- User Avatar + Dropdown -->
                <div class="ft-user" id="ft-user-wrap">
                    <div class="ft-user__avatar" id="ft-user-avatar" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" title="Account menu">
             
                    </div>

                    <!-- User dropdown menu -->
                    <div class="ft-user__menu ft-dropdown--hidden" id="ft-user-menu" role="menu">

                        <!-- Hero section -->
                        <div class="ft-user__menu-hero" id="ft-user-menu-hero">
                            <div class="ft-user__menu-hero-top">
                                <div class="ft-user__menu-avatar-lg" id="ft-user-menu-avatar"></div>
                                <div class="ft-user__menu-info">
                                    <div class="ft-user__menu-name" id="ft-user-menu-name"></div>
                                    <div class="ft-user__menu-role" id="ft-user-menu-role">Project Manager</div>
                                    <div class="ft-user__menu-email" id="ft-user-menu-email">
                                        <i class="bi bi-envelope-fill"></i> m.nauman@fophex.com
                                    </div>
                                </div>
                            </div>
                            <!-- Quick stats -->
                            <div class="ft-user__menu-stats" id="ft-user-menu-stats">
                                <div class="ft-user__menu-stat">
                                    <div class="ft-user__menu-stat-val" id="ft-stat-tasks">12</div>
                                    <div class="ft-user__menu-stat-lbl">My Tasks</div>
                                </div>
                                <div class="ft-user__menu-stat">
                                    <div class="ft-user__menu-stat-val" id="ft-stat-review">3</div>
                                    <div class="ft-user__menu-stat-lbl">In Review</div>
                                </div>
                                <div class="ft-user__menu-stat">
                                    <div class="ft-user__menu-stat-val" id="ft-stat-overdue">2</div>
                                    <div class="ft-user__menu-stat-lbl">Overdue</div>
                                </div>
                            </div>
                        </div>

                        <!-- Menu items -->
                        <div class="ft-user__menu-body">
                            <div class="ft-user__menu-item" id="ft-menu-profile" role="menuitem">
                                <i class="bi bi-person-circle"></i> My Profile
                            </div>
                            <div class="ft-user__menu-item" id="ft-menu-my-tasks" role="menuitem">
                                <i class="bi bi-check2-square"></i> My Tasks
                                <span class="ft-user__menu-item-badge ft-badge--teal" id="ft-my-tasks-count">12 open</span>
                            </div>
                            <div class="ft-user__menu-item" id="ft-menu-notifications" role="menuitem">
                                <i class="bi bi-bell"></i> Notifications
                                <span class="ft-user__menu-item-badge ft-badge--red" id="ft-notif-count">3</span>
                            </div>
                            <div class="ft-user__menu-separator"></div>
                            <div class="ft-user__menu-item" id="ft-menu-settings" role="menuitem">
                                <i class="bi bi-gear"></i> Settings
                            </div>
                            <div class="ft-user__menu-item" id="ft-menu-permissions" role="menuitem">
                                <i class="bi bi-shield-check"></i> Permissions
                            </div>
                            <div class="ft-user__menu-item" id="ft-menu-appearance" role="menuitem">
                                <i class="bi bi-palette"></i> Appearance
                            </div>
                            <div class="ft-user__menu-separator"></div>
                            <div class="ft-user__menu-item ft-user__menu-item--danger" id="ft-menu-signout" role="menuitem">
                                <i class="bi bi-box-arrow-right"></i> Sign out
                            </div>
                        </div>

                    </div><!-- /ft-user__menu -->
                </div><!-- /ft-user -->

            </div><!-- /ft-header__right -->

        </header><!-- /ft-header -->
        @RenderBody()
    </div>
    @* add people modal  *@
    <div class="modal fade flowtic-modal" id="addPeopleModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered ">
            <div class="modal-content flowtick-modal-box p-0">
                <form id="addPeopleForm">
                    <div class="modal-header flowtick-modal-header  py-1">
                        <h5 class="modal-title">
                            <i class="bi bi-person-plus me-2 green"></i> Add Member
                        </h5>
                        <button type="button" class="btn border-0 p-0" data-bs-dismiss="modal"><i class="bi bi-x-lg modal-btn-close"></i></button>
                    </div>

                    <div class="modal-body">

                        <div class="row">
                            <div class="col-12">
                                <label class="form-label">Emails <span class="required">*</span> </label>
                                <input type="text" class="form-control custom-input mb-3" id="email" placeholder="e.g.,aman@company.com, usman@company.com" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <label class="form-label">Role <span class="required">*</span> </label>
                                <select id="roleId" class="form-select selector_2" required>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-create " id="closeModal" data-bs-dismiss="modal" style="background:#6c757d;">Close</button>
                        <button type="button" class="btn btn-create ms-0" id="addPeople"><i class="bi bi-plus-lg me-1"></i> Add </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade flowtic-modal" id="createProjectModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered ">
            <div class="modal-content flowtick-modal-box p-0">
                <form id="createProjectForm">
                    <div class="modal-header flowtick-modal-header py-1 ">
                        <h5 class="modal-title">Create Project</h5>
                        <button type="button" class="btn border-0 p-0" data-bs-dismiss="modal"><i class="bi bi-x-lg modal-btn-close"></i></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Project Name</label>
                        <input type="text" class="form-control" id="name" placeholder="Enter project name">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-create" id="saveProject">
                            <i class="bi bi-plus-lg"></i> Create
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    @* add board modal  *@
    <div class="modal fade flowtic-modal" id="addBoardModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered ">
            <div class="modal-content flowtick-modal-box p-0">
                <form id="boardForm">
                    <input type="hidden" name="name" id="boardProjectId" value="" />
                    <div class="modal-header flowtick-modal-header  py-1">
                        <h5 class="modal-title">
                            <i class="bi bi-person-plus me-2 green"></i> Add Board
                        </h5>
                        <button type="button" class="btn border-0 p-0" data-bs-dismiss="modal"><i class="bi bi-x-lg modal-btn-close"></i></button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <label class="form-label">Type <span class="required">*</span> </label>
                                <select id="typeId" class="form-select selector_2" required>
                                    <option  >Select Type</option>
                                    <option value="kanban">Kanban</option>
                                    <option value="scrum">Scrum</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <label class="form-label">Name <span class="required">*</span> </label>
                                <input type="text" class="form-control custom-input " id="boardName" placeholder="Enter Board Name" required>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12">
                                <label class="form-label">Description <span class="required">*</span> </label>
                                <input type="text" class="form-control custom-input " id="boardDescription" placeholder="Enter Board Description" required>
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-create " id="closeModal" data-bs-dismiss="modal" style="background:#6c757d;">Close</button>
                        <button type="button" class="btn btn-create ms-0" id="addboard" onclick="addBoard()"><i class="bi bi-plus-lg me-1"></i> Save </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/layout/js/select2.min.js"></script>
    <script src="~/js/functionalityjs/common-script.js"></script>
	<script src="~/js/functionalityjs/dashboard/flowtick-header.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
 @*    Add Member Modal Partial View *@
    @{
        @await Html.PartialAsync("~/Views/Shared/PartialViews/Modal/_AddMemberModalPartialView.cshtml")
        ;
    }

    @*    Add Board Modal Partial View *@
    @{
        @await Html.PartialAsync("~/Views/Shared/PartialViews/Modal/_AddBoardModalPartialView.cshtml")
        ;
    }
    <script>

        // Sidebar Toggle
        $(function () {
            /*
             //take data from access token
            const token = localStorage.getItem("accessToken");

            const tokenData = parseJwt(token);
              var loginUserID = tokenData["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"];
            const userName = tokenData["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"];       
            */
            let user = getLoggedInUser();
            $('#ft-user-avatar').text(getInitials(user.name));
            $('#ft-user-menu-avatar').text(getInitials(user.name));
            $('#ft-user-menu-name').text(user.name);

            //end


            var urlParameters = new URLSearchParams(window.location.search);
            let project = urlParameters.get('project'); 
            var  projectType = urlParameters.get('type');
            $('#ft-bc-project-name').text(project);
                    //set board name scrum / board
            $('#ft-board-badge').text(projectType + ' Board');

            getMyProjects();
            $('#toggleSidebar').on('click', function () {
                $('#sidebar').toggleClass('collapsed');
                $('#mainContent').toggleClass('expanded');
                $('.bi-three-dots').toggleClass('d-none');
                $('.bi-kanban').toggleClass('ps-1');
                // Reinitialize tooltips
                setTimeout(() => {
                    initTooltips();
                }, 300);
            });

            // $("#addPeople").click(function (e) {

            //     e.preventDefault();
            //     addPeopleToProject();
            // });

            // $("#btnCreateProject").click(function () {

            //     $('#createProjectModal').modal('show');
            // })

            // $("#saveProject").click(function () {
            //     createProject()
            // }); 
            $("#ft-menu-signout").click( function(){
                redirectToAction('/Auth/Login?key=', 10);
            });
            $("#ft-menu-profile").click( function(){
                redirectToAction('/User/Profile?id=',1);
            });

         $("#userAvatar").on("click", function (e) {
            e.stopPropagation();

            $(".user-profile-dropdown").remove(); // prevent duplicate

            let offset = $(this).offset();
            let height = $(this).outerHeight();

            $("body").append(`
                <div class="user-profile-dropdown"
                     style="
                        position:absolute;
                        top:${offset.top + height + 8}px;
                        right:23px;
                        width:140px;
                        background:#fff;
                        border-radius:10px;
                        box-shadow:0 10px 25px rgba(0,0,0,.12);
                        padding:8px 0;
                        z-index:9999;
                     ">

                    <a class="dropdown-item d-flex align-items-center px-2 py-1"
                       role="button"
                       onclick="redirectToAction('/User/Profile?id=',1)">
                        <i class="bi bi-person-circle me-1 green"></i>
                        <span>Profile</span>
                    </a>

                    <a class="dropdown-item d-flex align-items-center px-2 py-1 text-danger"
                       role="button"
                       onclick="redirectToAction('/Auth/Login?key=',10)">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        <span>Logout</span>
                    </a>
                </div>
            `);
          });

        });
        function getMyProjects() {
            apiRequest({
                url: 'flowtick/projects/me',
                type: 'GET',
                data: {},
                callBack: getMyProjectsCallBack
            });
        }
        var getMyProjectsCallBack = function (response) {
            if (response.request.status === 201) {

                var projects = response.data;

                var $container = $("#projectContainer");
                var $sidebar = $("#sidebarProjects");

                $container.html("");
                $sidebar.html("");

                $.each(projects, function (index, project) {
                   let isOwner = project.role && project.role.name === "Owner";

                   let boardsHtml = '';

                    //  loop boards here
                    if (project.boards && project.boards.length > 0) {
                        $.each(project.boards, function (i, board) {
                            let encBoardId = encryptNumber(board.id);
                            boardsHtml += `
                                <a href="#" class="nav-link" id="board-${board.id}"
                                   onclick="redirectToAction('/Board/Project?project=${project.name}&type=${board.type}&boardId=${encBoardId}&id=', ${project.id})"
                                   data-bs-toggle="tooltip" title="${board.name}">
                                   <img src="/img/logo/logo.png" style="width:15px; height:15px;" />
                                   <span class="nav-link-text ">${board.name}</span>
                                </a>
                            `;
                        });
                    }

                    $sidebar.append(
                            `<div class="project-item">

                                <!-- Parent Project -->
                                <a href="#" class="nav-link project-toggle d-flex align-items-center"
                                    onclick="toggleProjectMenu(event, ${project.id})"
                                    data-bs-toggle="tooltip" title="${project.name}">

                                    <img src="/img/logo/logo.png" style="width:15px; height:15px;" />
                                    <span class="nav-link-text ">${project.name}</span>

                                    <span class="ms-auto three-dots" onclick="handleThreeDots(event, ${project.id}, ${isOwner}, '${project.name}')">
                                        <i class="bi bi-three-dots"></i>
                                    </span>

                                </a>

                                <!-- Submenu -->
                                <div class="project-submenu ps-4" id="submenu-${project.id}" style="display:none;">
                                       ${boardsHtml}
                                </div>

                            </div>`
                            );
                    // Dashboard project cards
                    $container.append(`
                                                                    <div class="col-12 col-sm-6 col-md-4">
                                                                        <div class="app-card active open-project-board" data-id="${project.id}" data-name=" ${project.name}" >
                                                                            <div class="d-flex align-items-center">
                                                                                <div class="app-icon bg-light">
                                                                                    <img src="/img/logo/logo.png" style="width:32px; height:32px;" />
                                                                                </div>
                                                                                <div class="ms-3">
                                                                                    <h6 class="mb-0 fw-semibold">${project.name}</h6>
                                                                                    <small class="text-muted">${project.description}</small>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                              `);
                });

                $("#sidebarProjects a.nav-link").each(function () {
                    const title = $(this).attr("title");
                    if (title === $('#ProjectName').text()) {
                        $("#sidebarProjects a.nav-link").removeClass("active");
                      //  $(this).addClass("active");
                        //open current project boards
                      let submenu = $('#submenu-' + projectId);
                       $('#board-' + boardId).addClass("active");;
                      submenu.slideToggle(200);
                      
                      //submenu.find("a.nav-link").addClass("active");

                    }
                });
                //  define trigger when sidebar is loadded  add the active class to that menu item by using this trigger name  on the project view js
                //$(document).trigger("sidebarProjectsLoaded");
            }
            else {                
                errorExtractor(response);

            }
        };
        function toggleProjectMenu(e, projectId) {
            e.preventDefault();

            let submenu = $('#submenu-' + projectId);

            // toggle current
            submenu.slideToggle(200);

            // OPTIONAL: close others
            $('.project-submenu').not(submenu).slideUp(200);
        }
        // Initialize Tooltips
        function initTooltips() {
            const sidebar = $('#sidebar');
            if (sidebar.hasClass('collapsed')) {
                $('[data-bs-toggle="tooltip"]').tooltip('dispose');
                $('[data-bs-toggle="tooltip"]').tooltip();
            } else {
                $('[data-bs-toggle="tooltip"]').tooltip('dispose');
            }
        }

        function handleThreeDots(event, projectId, isOwner,projectName) {
            event.stopPropagation();   // stops parent <a> click
            event.preventDefault();    // prevents link navigation (important)

            $(".project-dropdown").remove();

            //let projectId = $(this).closest('.menu-item').data('id');// <-- project id

            const $el = $(event.currentTarget);

            let offset = $el.offset();
            let height = $el.outerHeight();

            $("body").append(`
                                                <ul class="dropdown-menu project-dropdown"

                                                 data-id="${projectId}"
                                                 data-project-name="${projectName}"
                                                    style="
                                                        display:block;
                                                        position:absolute;
                                                        top:${offset.top + height}px;
                                                        left:${offset.left - 10}px;

                            ">
                            <li><a class="dropdown-item" onclick="redirectToAction('/Project/Backlog?id=',${projectId});"><i class="bi bi-list-task me-2"></i>Backlog </a></li>
                            <li><a class="dropdown-item" id="addPeopleBtn"><i class="bi bi-person-add me-2"></i>Add Member</a></li>
