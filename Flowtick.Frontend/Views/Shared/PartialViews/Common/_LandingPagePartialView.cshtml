      var STATS={tasks:[{v:87,l:'Completed'},{v:25,l:'In progress'},{v:12,l:'Overdue'}],sprints:[{v:6,l:'Sprints'},{v:186,l:'Points'},{v:32,l:'Avg velocity'}],members:[{v:4,l:'Members'},{v:124,l:'Assigned'},{v:31,l:'Avg tasks'}],projects:[{v:8,l:'Projects'},{v:58,l:'Avg % done'},{v:3,l:'Active sprints'}]};

      function openCB(){document.getElementById('ft-cb-overlay').classList.add('open');renderCB();}
      function closeCB(){document.getElementById('ft-cb-overlay').classList.remove('open');}

      document.getElementById('create-cta').addEventListener('click',openCB);
      document.getElementById('create-cta').addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')openCB();});
      document.getElementById('cbm-x').addEventListener('click',closeCB);
      document.getElementById('ft-cb-overlay').addEventListener('click',function(e){if(e.target===this)closeCB();});
      document.addEventListener('keydown',function(e){if(e.key==='Escape')closeCB();});

      function renderCB(){
        var d=DS[CB.src][CB.grp],colors=PAL[CB.pal];
        var ctx=document.getElementById('cbm-canvas');
        if(cbChart)cbChart.destroy();
        var isPie=['pie','doughnut','polarArea'].indexOf(CB.type)>-1;
        var bgC=isPie?d.l.map(function(_,i){return colors[i%colors.length];}):colors[0];
        var ds={label:document.getElementById('cbn').value||'My Chart',data:d.d,backgroundColor:bgC,borderColor:isPie?bgC:colors[0],borderWidth:isPie?0:2,borderRadius:CB.type==='bar'?4:0,tension:.4,fill:CB.type==='line',pointBackgroundColor:colors[0]};
        if(CB.type==='line')ds.backgroundColor=colors[0]+'22';
        cbChart=new Chart(ctx,{type:CB.type,data:{labels:d.l,datasets:[ds]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:isPie?{}:{x:{grid:{display:false},ticks:{font:{size:10}}},y:{grid:{color:'rgba(0,0,0,0.05)'},ticks:{font:{size:10}}}}}});
        var leg=document.getElementById('cbm-legend');leg.innerHTML='';
        d.l.forEach(function(lbl,i){var c=Array.isArray(bgC)?bgC[i%bgC.length]:colors[0];var s=document.createElement('span');s.className='cbm-leg';s.innerHTML='<span class="cbm-leg-sw" style="background:'+c+'"></span>'+lbl;leg.appendChild(s);});
        var sn={tasks:'Tasks',sprints:'Sprint velocity',members:'Team workload',projects:'Project progress'};
        document.getElementById('cprev-sub').textContent=sn[CB.src]+' \u00b7 '+CB.grp+' \u00b7 all projects';
        document.getElementById('cprev-title').textContent=document.getElementById('cbn').value||'My Chart';
        STATS[CB.src].forEach(function(s,i){document.getElementById('cs'+(i+1)+'v').textContent=s.v;document.getElementById('cs'+(i+1)+'l').textContent=s.l;});
      }

      document.getElementById('cbt-grid').addEventListener('click',function(e){var c=e.target.closest('.cbt');if(!c)return;document.querySelectorAll('.cbt').forEach(function(x){x.classList.remove('on')});c.classList.add('on');CB.type=c.dataset.type;renderCB();});
      document.getElementById('cbs-list').addEventListener('click',function(e){var c=e.target.closest('.cbs');if(!c)return;document.querySelectorAll('.cbs').forEach(function(x){x.classList.remove('on');var ch=x.querySelector('.cbs-chk');if(ch)ch.remove();});c.classList.add('on');var i=document.createElement('i');i.className='bi bi-check2 cbs-chk';c.appendChild(i);CB.src=c.dataset.src;renderCB();});
      document.getElementById('cbg-wrap').addEventListener('click',function(e){var b=e.target.closest('.cbg');if(!b)return;document.querySelectorAll('.cbg').forEach(function(x){x.classList.remove('on')});b.classList.add('on');CB.grp=b.dataset.g;renderCB();});
      document.getElementById('cbc-wrap').addEventListener('click',function(e){var c=e.target.closest('.cbc');if(!c)return;document.querySelectorAll('.cbc').forEach(function(x){x.classList.remove('on')});c.classList.add('on');CB.pal=c.dataset.p;renderCB();});
      document.getElementById('cbn').addEventListener('input',function(){document.getElementById('cprev-title').textContent=this.value||'My Chart';});
      document.getElementById('cbm-refresh').addEventListener('click',renderCB);
      document.getElementById('cbm-save').addEventListener('click',function(){
        var name=document.getElementById('cbn').value.trim()||'My Chart';
        closeCB();
        var t=document.getElementById('ft-toast');
        document.getElementById('toast-msg').textContent='"'+name+'" saved to dashboard!';
        t.classList.add('show');
        setTimeout(function(){t.classList.remove('show');},3000);
      });

    });

