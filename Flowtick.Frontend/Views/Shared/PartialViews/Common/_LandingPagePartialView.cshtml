
<style>

    .ft-content {
           padding: 18px !important;
                  gap: 16px
    }
    /* ── COMPACT HERO BANNER ── */
    .hero {
        background: linear-gradient(135deg,#0c6b62 0%,#0d9488 40%,#12b0a2 80%,#14b8a6 100%);
