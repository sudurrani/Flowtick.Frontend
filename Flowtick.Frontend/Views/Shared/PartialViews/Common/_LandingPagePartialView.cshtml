        z-index: 1;
        cursor: pointer;
        transition: background .15s;
        min-width: 72px
    }

        .hero-stat:last-child {
            border-right: none
        }

        .hero-stat:hover {
            background: rgba(255,255,255,.09)
        }

    .hero-stat-val {
        font-size: 20px;
        font-weight: 800;
        color: #fff;
        line-height: 1;
        letter-spacing: -.02em
    }

    .hero-stat-lbl {
        font-size: 9.5px;
        color: rgba(255,255,255,.65);
        margin-top: 2px;
        font-weight: 500;
        white-space: nowrap
    }

    .hero-stat-sub {
        font-size: 9px;
        color: rgba(255,255,255,.55);
        margin-top: 1px;
        display: flex;
        align-items: center;
        gap: 2px;
        justify-content: center
    }
    /* METRICS */
    .metrics {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 10px
    }

    .mc {
        background: var(--card);
        border: 1px solid var(--bd);
        border-radius: 10px;
        padding: 12px 14px;
        transition: all .15s;
        cursor: default
    }

        .mc:hover {
            border-color: var(--pt-bd);
            box-shadow: 0 2px 8px rgba(13,148,136,.07)
        }

    .mc-top {
        display: flex;
        align-items: flex-start;
