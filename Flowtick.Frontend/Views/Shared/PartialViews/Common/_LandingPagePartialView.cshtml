        display: flex;
        align-items: stretch;
        position: relative;
        flex-shrink: 0;
        min-height: 86px;
    }

    .hero-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse at 75% 40%,rgba(255,255,255,.13) 0%,transparent 55%),radial-gradient(ellipse at 10% 80%,rgba(255,255,255,.07) 0%,transparent 40%)
