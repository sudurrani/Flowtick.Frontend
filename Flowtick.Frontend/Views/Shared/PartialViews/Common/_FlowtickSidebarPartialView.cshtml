<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --pt:#0d9488;--pt-h:#0f766e;--pt-lt:#f0fdfa;--pt-mid:#ccfbf1;--pt-bd:#5eead4;
  --bg:#f1f5f9;--card:#fff;--bd:#e2e8f0;--bd2:#f8fafc;
  --txt:#0f172a;--txt2:#475569;--txt3:#94a3b8;
  --sb-w:242px;--sb-slim:52px;--top-h:52px;
}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--txt);margin:0}

/* ── shell ── */
.ft-shell{display:flex;height:100%;border-radius:12px;border:1px solid var(--bd);position:relative;background:var(--bg)}

/* ═══════ SIDEBAR ═══════ */
.ft-sb{
  width:var(--sb-w);height:100%;flex-shrink:0;
  background:var(--card);border-right:1px solid var(--bd);
  display:flex;flex-direction:column;
  transition:width .22s ease;overflow:hidden;
  /* sticky within shell */
  position:relative;z-index:2;flex-shrink:0;
}
.ft-sb.slim{width:var(--sb-slim);
   
}

/* logo row */
.sb-logo{display:flex;align-items:center;gap:9px;padding:12px 12px 12px 2px;border-bottom:1px solid var(--bd);flex-shrink:0;min-height:var(--top-h)}
.sb-logo-icon{width:28px;height:28px;border-radius:8px;background:var(--pt);display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;flex-shrink:0}
.sb-logo-name{font-size:14px;font-weight:800;color:var(--txt);letter-spacing:-.03em;white-space:nowrap;flex:1;overflow:hidden}
.sb-logo-name span{color:var(--pt)}
.sb-tog{width:26px;height:26px;border-radius:7px;border:none;background:transparent;cursor:pointer;color:var(--txt3);font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0}
.sb-tog:hover{background:var(--pt-lt);color:var(--pt)}
/* slim logo */
.ft-sb.slim .sb-logo-name{display:none}

/* body */
.sb-body{flex:1;overflow-y:auto;overflow-x:hidden;padding:8px 0}
.sb-body::-webkit-scrollbar{width:3px}

        .sb-body::-webkit-scrollbar-thumb {
            background: #0d9488;
            border-radius: 3px
        }
.sb-lbl{font-size:10px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.09em;padding:10px 14px 3px;white-space:nowrap;overflow:hidden}
.sb-div{height:1px;background:var(--bd);margin:6px 8px}
.ft-sb.slim .sb-lbl,.ft-sb.slim .sb-div{display:none}

/* nav items */
.sb-nav{display:flex;align-items:center;line-height:normal !important; gap:9px;padding:7px 10px;margin:1px 6px;border-radius:8px;cursor:pointer;color:var(--txt2);font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;transition:all .15s;text-decoration:none;border:none;background:transparent;width:calc(100% - 12px);text-align:left;font-family:inherit}
.sb-nav i{font-size:16px;flex-shrink:0;width:17px;text-align:center;color:var(--txt3)}
.sb-nav-txt{flex:1;overflow:hidden;text-overflow:ellipsis}
.sb-nav-badge{font-size:10px;font-weight:700;background:var(--pt);color:#fff;border-radius:20px;padding:1px 6px;flex-shrink:0}
.sb-nav:hover{background:var(--pt-lt);color:var(--pt)}
.sb-nav:hover i{color:var(--pt)}
.sb-nav.on{background:var(--pt);color:#fff;font-weight:600}
.sb-nav.on i{color:#fff}
.ft-sb.slim .sb-nav-txt,.ft-sb.slim .sb-nav-badge{display:none}

/* project rows */
.sb-proj{display:flex;align-items:center;gap:8px;padding:6px 10px;margin:1px 6px;border-radius:8px;cursor:pointer;transition:all .15s;position:relative}
.sb-proj:hover{background:var(--bg)}
.sb-proj:hover .sb-pdots{opacity:1}
.sb-pav{width:18px;height:18px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;color:#fff;flex-shrink:0}
.sb-pname{font-size:12px;color:var(--txt2);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-pchev{font-size:11px;color:var(--bd);flex-shrink:0;transition:transform .2s}
.sb-pchev.open{transform:rotate(90deg)}
.sb-pdots{width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;color:var(--txt3);font-size:13px;flex-shrink:0;opacity:0;transition:all .15s;border:none;background:transparent;cursor:pointer}
.sb-pdots:hover{background:var(--bd);color:var(--pt)}
.ft-sb.slim .sb-pname,.ft-sb.slim .sb-pchev,.ft-sb.slim .sb-pdots{display:none}

/* boards */
.sb-boards{overflow:hidden;max-height:0;transition:max-height .2s ease}
.sb-boards.open{max-height:200px}
.sb-board{display:flex;align-items:center;gap:7px;padding:5px 10px 5px 34px;margin:1px 6px;border-radius:7px;cursor:pointer;font-size:11.5px;color:var(--txt3);transition:all .12s;white-space:nowrap;overflow:hidden}
.sb-board i{font-size:11px;flex-shrink:0}
.sb-board:hover{background:var(--bg);color:var(--pt)}
.sb-board.on{color:var(--pt);font-weight:600}
.ft-sb.slim .sb-boards{display:none!important}

/* add project */
.sb-add{display:flex;align-items:center;gap:7px;padding:6px 10px;margin:3px 6px;border-radius:8px;cursor:pointer;font-size:12px;color:var(--pt);transition:all .15s}
.sb-add:hover{background:var(--pt-lt)}
.ft-sb.slim .sb-add span{display:none}

/* footer */
.sb-foot{padding:10px 12px;border-top:1px solid var(--bd);display:flex;align-items:center;gap:9px;flex-shrink:0}
.sb-fav{width:28px;height:28px;border-radius:50%;background:var(--pt);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;border:2px solid var(--pt-bd)}
.sb-fname{font-size:11.5px;font-weight:600;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-frole{font-size:10px;color:var(--txt3)}
.ft-sb.slim .sb-fname,.ft-sb.slim .sb-frole{display:none}

/* ═══════ MAIN ═══════ */
.ft-main{flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden}

/* topbar — sticky inside main */
.ft-top{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 18px;height:var(--top-h);min-height:var(--top-h);
  background:var(--card);border-bottom:1px solid var(--bd);
  flex-shrink:0;gap:10px;position:relative;z-index:10;
}

    /* scrollable content */
    .ft-content {
        flex: 1;
        overflow-y: auto;
     /*    padding: 18px; */
        display: flex;
        flex-direction: column;
 
    }

        .ft-content::-webkit-scrollbar {
            width: 4px;
         
        }

        .ft-content::-webkit-scrollbar-thumb {
            background: #0d9488;
            border-radius: 4px
        }

    /* main box */
    .select2-container--default .select2-selection--single {
        height: 38px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #ffffff;
        display: flex;
        align-items: center;
        padding: 0 12px;
        font-size: 13px;
    }

        /* hover */
        .select2-container--default .select2-selection--single:hover {
            border-color: #cbd5e1;
        }

    /* focus */
    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #0d9488;
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.12);
    }

    /* text */
    .select2-container--default .select2-selection__rendered {
        color: #0f172a;
        font-size: 13px;
        line-height: 38px;
    }

    /* arrow */
    .select2-container--default .select2-selection__arrow {
        height: 38px;
    }


/* RESPONSIVE */
@@media(max-width:820px){
  .ft-sb{position:absolute!important;top:0;left:0;height:100%;z-index:20;transform:translateX(-100%);transition:transform .22s ease,width .22s ease;width:var(--sb-w)!important}
  .ft-sb.mob-open{transform:translateX(0)!important}
  .ft-sb.slim{transform:translateX(-100%)!important}
  .ft-main{width:100%;flex:1}
  .metrics{grid-template-columns:1fr 1fr}
  .g21,.g-sp{grid-template-columns:1fr}
  .g11{grid-template-columns:1fr}

        .hero-stats {
            display: none
        }
  .cbm-body{grid-template-columns:1fr}
  .cbm-left{max-height:200px;border-right:none;border-bottom:1px solid var(--bd)}
}
@@media(max-width:480px){
  .metrics{grid-template-columns:1fr 1fr;gap:8px}
  .g3,.charts-grid{grid-template-columns:1fr}
  .ft-content{padding:12px;gap:12px}

        .hero-name {
            font-size: 16px
        }

        .hero-chips {
            display: none
        }
  .top-srch input{width:110px}
  .top-add span{display:none}
}

    /* CONTEXT MENU */
    .ctx-menu {
        position: absolute;
        background: var(--card);
        border: 1px solid var(--bd);
        border-radius: 9px;
        padding: 4px;
        min-width: 155px;
        z-index: 300;
        box-shadow: 0 6px 18px rgba(0,0,0,.1);
        display: none
    }

    .ctx-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 9px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11.5px;
        color: var(--txt);
        transition: background .1s
    }

        .ctx-item i {
            font-size: 13px;
            color: var(--txt3);
            flex-shrink: 0;
            width: 13px;
            text-align: center
        }

        .ctx-item:hover {
            background: var(--bg)
        }

            .ctx-item:hover i {
                color: var(--pt)
            }

    .ctx-sep {
        height: 1px;
        background: var(--bd2);
        margin: 3px 0
    }

    .ctx-danger {
        color: #ef4444
    }

        .ctx-danger i {
            color: #ef4444
        }

        .ctx-danger:hover {
            background: #fff5f5
        }
</style>
