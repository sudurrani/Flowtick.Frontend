<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="~/js/functionalityjs/common-script.js"></script>
<script>

    $(document).ready(function () {

        $('.select2').select2({
            width: '100%'
        });
        getMyProjects();
              /* ── sidebar state ── */
      var sbSlim=false,sbMobOpen=false;
      var isMob=function(){return window.innerWidth<=820;};


      /* sidebar internal toggle (desktop only) */
      document.getElementById('sb-tog').addEventListener('click',function(e){
        e.stopPropagation();
        if(!isMob()){
          sbSlim=!sbSlim;
          document.getElementById('ft-sb').classList.toggle('slim',sbSlim);
          $('#sb-tog-header').show();
        }
      });
        $('#sb-tog-header').click( function(){
            if(!isMob()){
              sbSlim=!sbSlim;
              document.getElementById('ft-sb').classList.toggle('slim',sbSlim);
              $('#sb-tog-header').hide();
            }
        });
    /* ── project boards expand ── */
        $(document).on('click', '.sb-proj', function (e) {

            if ($(e.target).closest('.sb-pdots').length) return;

            var pid = $(this).data('pid');

            $('#boards-' + pid).toggleClass('open');

            $('#boards-' + pid).slideToggle(200);

            $('#chev-' + pid).toggleClass('open');
        });
      /* ── task check ── */
      document.querySelectorAll('.tchk').forEach(function(c){
        c.addEventListener('click',function(){
          c.classList.toggle('dn');
          var ico=c.querySelector('i'),nm=c.nextElementSibling;
          if(c.classList.contains('dn')){ico.style.display='';nm.classList.add('dn');}
          else{ico.style.display='none';nm.classList.remove('dn');}
        });
      });

          /* ── nav active ── */
          document.querySelectorAll('.sb-nav').forEach(function(n){
            n.addEventListener('click',function(){document.querySelectorAll('.sb-nav').forEach(function(x){x.classList.remove('on')});n.classList.add('on');});
          });



    });
        function getMyProjects() {
            apiRequest({
                url: 'flowtick/projects/me',
                type: 'GET',
                data: {},
                callBack: getMyProjectsTestCallBack
            });
        };
        var getMyProjectsTestCallBack = function (response) {
            if (response.request.status === 201) {
      
                var projects = response.data;
                var $sidebar = $("#sidebarProjectsContainer");

                $sidebar.html("");

                $.each(projects, function (index, project) {
                   let isOwner = project.role && project.role.name === "Owner";

                   let boardsHtml = '';

                    //  loop boards here
                    if (project.boards && project.boards.length > 0) {
                        $.each(project.boards, function (i, board) {
                            let encBoardId = encryptNumber(board.id);
                            boardsHtml += `
                                <div class="sb-boards open"
                                id="board-${board.id}"
                                   onclick="redirectToAction('/Board/Project?project=${project.name}&type=${board.type}&boardId=${encBoardId}&id=', ${project.id})"
                                   data-bs-toggle="tooltip" title="${board.name}">
                                    <div class="sb-board "> <i class="bi bi-kanban"></i> ${board.name}</div>
                                </div>
                            `;
                        });
                    }

                    $sidebar.append(
                            `
                                <div class="sb-proj" data-pid="${project.id}"
        
                                    data-bs-toggle="tooltip" title="${project.name}" >
                                    <div class="sb-pav" style="background:${project.color ?? '#0d9488'}"> ${getProjectInitial(project.name)}</div>
                                    <span class="sb-pname">${project.name}</span><i class="bi bi-chevron-right sb-pchev " id="chev-${project.id}"></i>
                                    <button class="sb-pdots" onclick="handleThreeDots(event, ${project.id}, ${isOwner}, '${project.name}')"><i class="bi bi-three-dots"></i></button>
                                </div>

                                <!-- Submenu -->
                                <div class="project-submenu ps-4" id="boards-${project.id}"  style="display:none;">
                                       ${boardsHtml}
                                </div>
                               `
                            );
          
                   });
                       /* active current project + board */
                    $('.sb-board').removeClass('on');
             
                    var currentProject = $('#ft-bc-project-name').text().trim();

                    $('.sb-proj').each(function () {
                        var projectTitle = $(this).attr('title').trim();
                        if (projectTitle === currentProject) {

                            var pid = $(this).data('pid');

                            $('#boards-' + pid).show().addClass('open');

                            $('#chev-' + pid).addClass('open');

                                   // check boardId exists
                            if (typeof boardId !== 'undefined' && boardId !== null && boardId !== '') {

                                $('#board-' + boardId + ' .sb-board').addClass('on');
                            }
                        }
                    });

            }
            else {
                errorExtractor(response);

            }
        };
    function handleThreeDots(event, projectId, isOwner, projectName) {
        event.stopPropagation();   // stops parent click
        event.preventDefault();    // prevents link navigation

        $(".ctx-menu").remove();

        const $el = $(event.currentTarget);

        var br = $el[0].getBoundingClientRect();

        var top = br.bottom + window.scrollY + 4;
        var left = br.left + window.scrollX - 80;

        $("body").append(`

            <div class="ctx-menu"
                 id="ft-ctx"
                 data-id="${projectId}"
                 data-project-name="${projectName}"
                 style="
                    top:${top}px;
                    left:${left}px;
                    display:block;
                    position:absolute;
                    z-index:99999;
                 ">
                <div class="ctx-item"
                     onclick="redirectToAction('/Project/Backlog?project=${projectName}&id=',${projectId});">
                     <i class="bi bi-list-ul"></i>
                     Backlog
                </div>

                <div class="ctx-item" id="addPeopleBtn">
                    <i class="bi bi-person-plus"></i>
                    Add Member
                </div>

                <div class="ctx-item"
                     onclick="openAddBoardModal(${projectId});">
                     <i class="bi bi-kanban"></i>
                     Add Board
                </div>

                ${isOwner ? `
                    <div class="ctx-item"
                         onclick="updateProject(${projectId});">
                         <i class="bi bi-gear"></i>
                         Settings
                    </div>

                    <div class="ctx-sep"></div>

                    <div class="ctx-item ctx-danger">
                        <i class="bi bi-trash3"></i>
                        Delete project
                    </div>
                ` : ''}

            </div>
        `);

        /* hide menu on outside click */
        $(document).off('click.ctxMenu').on('click.ctxMenu', function (e) {

            if (
                !$(e.target).closest('#ft-ctx').length &&
                !$(e.target).closest('.sb-pdots').length
            ) {
                $('#ft-ctx').hide();
            }
        });

        /* hide menu on menu item click */
        $('.ctx-item').off('click.ctxItem').on('click.ctxItem', function () {

            $('#ft-ctx').hide();
        });
    }
    function getProjectInitial(projectName) {

        if (!projectName) return '';
        return projectName.trim().charAt(0).toUpperCase();
    }
</script>