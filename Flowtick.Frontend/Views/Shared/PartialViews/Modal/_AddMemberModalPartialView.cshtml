
<link href="~/css/flowtickmodal/flowtick-modals.css" rel="stylesheet" />
<!-- ============================================================
     OVERLAY 1 — ADD MEMBER
     ============================================================ -->
<div class="ft-modal-overlay ft-hidden" id="ft-overlay-member">
  <div class="ft-modal" id="ft-modal-member">

    <!-- Header -->
    <div class="ft-modal__header">
      <div class="ft-modal__header-left">
        <div class="ft-modal__icon">
          <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
          <div class="ft-modal__title">Add Member</div>
                    <div class="ft-modal__subtitle">Invite people to <span id="member-modal-project-name"></span> </div>
        </div>
      </div>
            <button class="ft-modal__close" id="ft-close-member" aria-label="Close" onclick="closeModal('ft-overlay-member');">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- Body -->
    <div class="ft-modal__body">

      <!-- Email tag input -->
      <div class="ft-form-group" id="ft-fg-emails">
        <label class="ft-form-label" for="ft-email-input">
          Email addresses <span class="ft-label-required">*</span>
        </label>
        <div class="ft-tag-area" id="ft-tag-area" onclick="document.getElementById('ft-email-input').focus()">
@*           <span class="ft-tag-pill" id="ft-tag-default">
            nauman@fophex.com
            <span class="ft-tag-pill__remove" onclick="ftRemoveTag('ft-tag-default')" title="Remove">
              <i class="bi bi-x"></i>
            </span>
          </span> *@
          <input
            class="ft-tag-raw-input"
            id="ft-email-input"
            type="email"
            placeholder="Type email and press Enter or comma…"
            autocomplete="off"
          />
        </div>
        <span class="ft-form-hint">
          <i class="bi bi-info-circle"></i>
          Separate multiple emails with Enter or comma. Invites expire in 7 days.
        </span>
        <span class="ft-form-error ft-hidden" id="ft-error-email">
          <i class="bi bi-exclamation-circle-fill"></i> Please add one or more email.
        </span>
      </div>

      <!-- Role selector -->
      <div class="ft-form-group" id="ft-fg-role">
        <label class="ft-form-label">Role <span class="ft-label-required">*</span></label>
        <div class="ft-role-grid" id="ft-role-grid">

        </div>
      </div>

      <!-- Personal message -->
@*       <div class="ft-form-group" id="ft-fg-message">
        <label class="ft-form-label" for="ft-invite-message">
          Personal message <span class="ft-label-optional">(optional)</span>
        </label>
        <textarea
          class="ft-input"
          id="ft-invite-message"
          placeholder="Add a welcome note to the invitation email…"
          style="min-height:68px"
        ></textarea>
      </div> *@

      <!-- Current members -->
      <div class="ft-form-group" id="ft-fg-members">
        <label class="ft-form-label">Current members <span class="ft-label-optional" id="member-count"></span></label>
        <div class="ft-member-list" id="ft-member-list">

        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="ft-modal__footer">
      <div class="ft-modal__footer-note">
        <i class="bi bi-lock"></i> Invite link expires in 7 days
      </div>
      <div class="ft-modal__footer-actions">
                <button class="ft-btn-cancel" id="ft-cancel-member" onclick="closeModal('ft-overlay-member');">Cancel</button>
        <button class="ft-btn-primary" id="ft-submit-member">
          <i class="bi bi-send"></i> Send Invites
        </button>
      </div>
    </div>

  </div>
</div><!-- /ft-overlay-member -->

<!-- ============================================================
     JS — board-modals.js
     Depends on: jQuery 3.x
     ============================================================ -->
<script>
        var _projectMember = [];
$(function () {

   $(document).on('click', '#addPeopleBtn', function (e) {
       e.preventDefault();
       e.stopPropagation();

       let projectId = $('.project-dropdown').data('id');   // <-- get id
       let projectName = $('.project-dropdown').data('project-name');   // <-- get name
       $('#member-modal-project-name').text(projectName);
       $('#ft-overlay-member').attr('data-project-id', projectId);

       $('#ft-tag-area .ft-tag-pill').remove();
       $('#ft-email-input').val('');

        //remove validation
        $('#ft-tag-area').removeClass('ft-input--error');
        $('#ft-error-email').addClass('ft-hidden');

       $('#ft-overlay-member').removeClass('ft-hidden').addClass('ft-overlay--visible');

       $('.project-dropdown').remove();

        getRole();
        getProjectMembersList(projectId);
   });


  /* ── Role card selection (Add Member) ── */
      window.ftSelectRole = function (element) {
    $('.ft-role-card').removeClass('ft-role--selected');
           $(element).addClass('ft-role--selected');
  };


  /* ── Email tag input (Add Member) ── */
  $('#ft-email-input').on('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      var val = $(this).val().replace(',', '').trim();
      if (!val) return;
      var tagId = 'ft-tag-' + Date.now();
      var $pill = $(
        '<span class="ft-tag-pill" id="' + tagId + '">' +
        val +
        ' <span class="ft-tag-pill__remove" title="Remove">' +
        '<i class="bi bi-x"></i>' +
        '</span>' +
        '</span>'
      );
      $pill.find('.ft-tag-pill__remove').on('click', function () {
        $('#' + tagId).remove();
      });
      $(this).before($pill);
      $(this).val('');
    }
  });




  /* ── Submit handlers (wire up to your backend) ── */
  $('#ft-submit-member').on('click', function () {
       addPeopleToProject();
  });
});

  function getRole() {
        apiRequest({
             url: 'flowtick/project/roles',
             type: 'GET',
             data: {},
             callBack: getRoleCallBack
        });
  }

  var getRoleCallBack = function (response) {
     if (response.request.status === 200) {

       var roles = response.data; //  array

           var rolGrid = $("#ft-role-grid");
             rolGrid.empty();

        $.each(roles, function (index, role) {

            var roleName = role.description.toLowerCase();

            var icon = 'bi-person';
            var color = '#6b7280';
            var description = 'Standard access';

            if (roleName == 'owner') {
                icon = 'bi-award';
                color = '#d97706';
                description = 'Full project control';
            }

            else if (roleName == 'admin') {
                icon = 'bi-shield-check';
                color = '#0f766e';
                description = 'Manages team and settings';
            }

            else if (roleName == 'contributor') {
                icon = 'bi-kanban';
                color = '#4f46e5';
                description = 'Handles assigned work items';
            }

            else if (roleName == 'reader') {
                icon = 'bi-eye';
                color = '#64748b';
                description = 'View-only access';
            }
            else {
                icon = 'bi-person';
                color = '#6b7280';
                description = 'Standard access';
            }

            var roleCard = `
                <div class="ft-role-card ${index == 0 ? 'ft-role--selected' : ''}"
                     id="ft-role-${roleName}"
                     data-id="${role.id}"
                     data-role="${roleName}"
                     onclick="ftSelectRole(this)">

                    <div class="ft-role-card__icon">
                        <i class="bi ${icon}" style="color:${color}"></i>
                    </div>

                    <div class="ft-role-card__name">
                        ${role.description}
                    </div>

                    <div class="ft-role-card__desc">
                        ${description}
                    </div>

                </div>
            `;

            $('#ft-role-grid').append(roleCard);
        });
     }
     else {
        errorExtractor(response);
     }
  };
  
  function getProjectMembersList(projectId) {
        let url = `flowtick/project/${projectId}/members`;
        apiRequest({
            url: url,
            type: 'GET',
            data: {},
            callBack: getProjectMembersListCallBack
        });
    }
   var getProjectMembersListCallBack = function (response) {
        if (response.request.status === 200) {

            _projectMember = response.data;
           console.log(_projectMember);
           var membersList = $("#ft-member-list");
               membersList.empty();
           var totalMember = _projectMember.length;
             $('#member-count').text('(' + totalMember + ')')
           $.each(_projectMember , function(index , member){
               let memberList = `
                      <div class="ft-member-item" id="ft-member-mn">
                        <span class="ft-member-avatar" style="background:${member.colorCode}">${getInitials(member.user)}</span>
                        <div class="ft-member-info">
                              <div class="ft-member-name">${member.user}</div>
                              <div class="ft-member-email">${member.email}</div>
                        </div>
                          <span class="ft-role-tag ft-role-tag--dev">${member.role}</span>
                      </div>
               `
              membersList.append(memberList);

           });
        }
        else {
            _projectMember = [];
            errorExtractor(response);
        }
    };

   function addPeopleToProject() {

       if (!ftValidateMember()) return;

        let emails = [];
        // get emails from tags
        $('.ft-tag-pill').each(function () {
            let email = $(this).clone().find('span').remove().end().text().trim();

            if (email.length) {
                emails.push(email);
            }
        });

        // get current input value
        let currentEmail = $('#ft-email-input').val().trim();
        if (currentEmail.length) {
            emails.push(currentEmail);
        }

            // validate emails
        let valid = emails.every(e => /\S+@@\S+\.\S+/.test(e));

        if (!valid) {
            infoToastr('One or more emails are invalid', 'info');
            return;
        }
        // get projectId stored in modal
       let projectId = $('#ft-overlay-member').attr('data-project-id');
       let roleId = $('.ft-role-card.ft-role--selected').attr('data-id');
        inputJSON = {
              "email": emails,
              "projectid": projectId,
               "roleid": roleId,
        }

        apiRequest({
            url: 'flowtick/project/member/invite',
            type: 'POST',
            data: inputJSON,
            callBack: addPeopleToProjectCallBack
        });
    
   }
   var addPeopleToProjectCallBack = function (response) {
        if (response.request.status === 201) {
             successToastr("Send successfully", 'Invitation');
             $('#ft-overlay-member').removeClass('ft-overlay--visible').addClass('ft-hidden');

        } else {
            errorExtractor(response);
            $('#addPeopleModal').modal('hide');

        }
   }
   
  function ftValidateMember() {
       var valid = true;
       /* email*/
        let tagText = $('#ft-tag-area .ft-tag-pill').text().trim();
        let inputEmail = $('#ft-email-input').val().trim();

        // check if both are empty
        if (!tagText && !inputEmail) {
           $('#ft-tag-area').addClass('ft-input--error');
           $('#ft-error-email').removeClass('ft-hidden');
           valid = false;
        } else {
            $('#ft-tag-area').removeClass('ft-input--error');
            $('#ft-error-email').addClass('ft-hidden');
         }

      return valid;
  }
    function closeModal(modalId){
          $('#' + modalId).removeClass('ft-overlay--visible').addClass('ft-hidden');
    };
</script>

