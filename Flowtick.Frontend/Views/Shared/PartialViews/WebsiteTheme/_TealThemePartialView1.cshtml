@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ePharmacy – Pharmacy Management System | BK-InfoTech</title>
    <link rel="icon" href="~/CompanyLogos/bk-infotech.ico" type="image/x-icon">

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --teal: #0D7377;
            --teal-dark: #0A5557;
            --teal-deep: #063B3D;
            --teal-deeper: #031F20;
            --mint: #14BDAC;
            --mint-light: #7EE8DF;
            --mint-pale: #E6F9F8;
            --white: #ffffff;
            --off-white: #F4FAFA;
            --text-dark: #0D2B2C;
            --text-mid: #2E6668;
            --gray: #5C7A7B;
            --border: #C5E8E8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--off-white);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        h1, h2, h3 {
            font-family: 'Playfair Display', serif;
        }

        /* ── NAVBAR ── */
        .navbar {
            background: var(--teal-deeper);
            padding: 13px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 2px solid var(--mint);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .navbar-brand img {
                height: 46px;
                width: 46px;
                border-radius: 50%;
                object-fit: contain;
                background: var(--white);
                padding: 3px;
            }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            font-weight: 900;
            color: var(--mint-light);
            letter-spacing: 1px;
        }

        .brand-sub {
            font-size: 0.63rem;
            color: rgba(255,255,255,0.4);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .nav-link {
            color: rgba(255,255,255,0.65) !important;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 6px 14px !important;
            transition: color 0.2s;
        }

            .nav-link:hover {
                color: var(--mint-light) !important;
            }

        .btn-nav-cta {
            background: var(--mint) !important;
            color: var(--teal-deeper) !important;
            font-weight: 700 !important;
            border-radius: 5px;
            padding: 7px 20px !important;
            transition: background 0.2s;
        }

            .btn-nav-cta:hover {
                background: var(--mint-light) !important;
            }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(140deg, var(--teal-deeper) 0%, var(--teal-dark) 55%, #0B6B6E 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(circle at 75% 35%, rgba(20,189,172,0.18) 0%, transparent 55%), radial-gradient(circle at 15% 80%, rgba(126,232,223,0.07) 0%, transparent 45%);
            }

            .hero::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%2314BDAC' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
            }

        .hero-pill {
            display: inline-block;
            background: rgba(20,189,172,0.15);
            border: 1px solid rgba(20,189,172,0.4);
            color: var(--mint-light);
            font-size: 0.73rem;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            padding: 6px 18px;
            border-radius: 100px;
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            color: var(--white);
            line-height: 1.12;
            margin-bottom: 22px;
        }

            .hero h1 span {
                color: var(--mint-light);
            }

        .hero p {
            font-size: 1.08rem;
            color: rgba(255,255,255,0.65);
            line-height: 1.8;
            max-width: 510px;
            margin-bottom: 36px;
        }

        .btn-primary-hero {
            background: var(--mint);
            color: var(--teal-deeper);
            font-weight: 700;
            font-size: 0.95rem;
            padding: 14px 34px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.25s;
        }

            .btn-primary-hero:hover {
                background: var(--mint-light);
                color: var(--teal-deeper);
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(20,189,172,0.35);
            }

        .btn-outline-hero {
            background: transparent;
            color: rgba(255,255,255,0.8);
            font-weight: 500;
            font-size: 0.95rem;
            padding: 13px 28px;
            border: 1.5px solid rgba(255,255,255,0.25);
            border-radius: 5px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.25s;
        }

            .btn-outline-hero:hover {
                border-color: var(--mint);
                color: var(--mint-light);
            }

        .hero-visual {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(20,189,172,0.25);
            border-radius: 16px;
            padding: 28px;
            backdrop-filter: blur(12px);
            position: relative;
            z-index: 1;
        }

        .hero-stat-card {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(20,189,172,0.15);
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: background 0.2s;
        }

            .hero-stat-card:hover {
                background: rgba(20,189,172,0.1);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            background: var(--mint);
            color: var(--teal-deeper);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.4);
        }

        .stat-value {
            font-size: 0.97rem;
            color: var(--white);
            font-weight: 600;
        }

        /* ── SECTION BASE ── */
        .section-eyebrow {
            font-size: 0.72rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--teal);
            font-weight: 700;
            margin-bottom: 10px;
        }

        .section-title {
            font-size: clamp(1.85rem, 3.5vw, 2.7rem);
            color: var(--text-dark);
            margin-bottom: 14px;
            line-height: 1.2;
        }

        .section-subtitle {
            font-size: 1rem;
            color: var(--gray);
            line-height: 1.75;
            max-width: 560px;
        }

        .divider-teal {
            width: 52px;
            height: 3px;
            background: linear-gradient(90deg, var(--teal), var(--mint));
            border-radius: 2px;
            margin: 18px 0 30px;
        }

        /* ── FEATURES ── */
        .features-section {
            padding: 100px 0;
            background: var(--off-white);
        }

        .feature-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 32px 28px;
            height: 100%;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .feature-card::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--teal), var(--mint));
                transform: scaleX(0);
                transition: transform 0.3s;
            }

            .feature-card:hover {
                border-color: var(--mint);
                box-shadow: 0 12px 36px rgba(13,115,119,0.1);
                transform: translateY(-4px);
            }

                .feature-card:hover::after {
                    transform: scaleX(1);
                }

        .feature-icon {
            width: 56px;
            height: 56px;
            background: var(--mint-pale);
            color: var(--teal);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.55rem;
            margin-bottom: 20px;
        }

        .feature-card h5 {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .feature-card p {
            font-size: 0.9rem;
            color: var(--gray);
            line-height: 1.7;
        }

        /* ── MODULES ── */
        .modules-section {
            padding: 100px 0;
            background: linear-gradient(180deg, #EAF7F7 0%, var(--off-white) 100%);
        }

        .module-tab-btn {
            background: var(--white);
            border: 1.5px solid var(--border);
            color: var(--text-mid);
            font-weight: 500;
            padding: 10px 22px;
            border-radius: 6px;
            font-size: 0.87rem;
            cursor: pointer;
            transition: all 0.2s;
        }

            .module-tab-btn.active, .module-tab-btn:hover {
                background: var(--teal);
                border-color: var(--teal);
                color: var(--white);
                font-weight: 600;
            }

        .module-detail-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 40px;
            box-shadow: 0 4px 24px rgba(13,115,119,0.06);
        }

        .module-feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .module-feature-list li {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 10px 0;
                border-bottom: 1px solid #EAF3F3;
                font-size: 0.92rem;
                color: var(--text-dark);
            }

                .module-feature-list li:last-child {
                    border-bottom: none;
                }

                .module-feature-list li i {
                    color: var(--teal);
                    font-size: 1rem;
                    margin-top: 2px;
                    flex-shrink: 0;
                }

        .module-icon-big {
            font-size: 3.5rem;
            color: var(--teal);
        }

        /* ── PRICING ── */
        .pricing-section {
            padding: 100px 0;
            background: var(--teal-deeper);
            position: relative;
            overflow: hidden;
        }

            .pricing-section::before {
                content: '';
                position: absolute;
                top: -80px;
                left: 50%;
                transform: translateX(-50%);
                width: 900px;
                height: 350px;
                background: radial-gradient(ellipse, rgba(20,189,172,0.12) 0%, transparent 70%);
            }

            .pricing-section .section-title {
                color: var(--white);
            }

            .pricing-section .section-subtitle {
                color: rgba(255,255,255,0.5);
            }

            .pricing-section .section-eyebrow {
                color: var(--mint-light);
            }

        .plan-card {
            background: rgba(255,255,255,0.04);
            border: 1.5px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 36px 30px;
            height: 100%;
            position: relative;
            transition: all 0.3s;
        }

            .plan-card:hover {
                border-color: rgba(20,189,172,0.45);
                background: rgba(20,189,172,0.06);
                transform: translateY(-5px);
            }

            .plan-card.featured {
                border-color: var(--mint);
                background: rgba(20,189,172,0.08);
            }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--mint);
            color: var(--teal-deeper);
            font-size: 0.67rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 5px 18px;
            border-radius: 100px;
        }

        .plan-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--white);
            margin-bottom: 5px;
        }

        .plan-tagline {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.4);
            margin-bottom: 22px;
        }

        .plan-price {
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--mint-light);
            line-height: 1;
        }

            .plan-price sup {
                font-size: 1rem;
                vertical-align: top;
                margin-top: 8px;
            }

            .plan-price span {
                font-size: 0.88rem;
                color: rgba(255,255,255,0.35);
                font-weight: 400;
            }

        .plan-divider {
            border-top: 1px solid rgba(255,255,255,0.08);
            margin: 22px 0;
        }

        .plan-feature {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 0;
            font-size: 0.87rem;
        }

            .plan-feature.available {
                color: rgba(255,255,255,0.82);
            }

            .plan-feature.unavailable {
                color: rgba(255,255,255,0.22);
            }

            .plan-feature i.bi-check-circle-fill {
                color: var(--mint);
            }

            .plan-feature i.bi-x-circle {
                color: rgba(255,255,255,0.2);
            }

        .btn-plan {
            display: block;
            width: 100%;
            padding: 13px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
            text-align: center;
            text-decoration: none;
            margin-top: 26px;
            transition: all 0.25s;
            border: none;
            cursor: pointer;
        }

        .btn-plan-outline {
            background: transparent;
            border: 1.5px solid rgba(20,189,172,0.4);
            color: var(--mint-light);
        }

            .btn-plan-outline:hover {
                background: var(--mint);
                color: var(--teal-deeper);
            }

        .btn-plan-filled {
            background: var(--mint);
            color: var(--teal-deeper);
        }

            .btn-plan-filled:hover {
                background: var(--mint-light);
                box-shadow: 0 6px 20px rgba(20,189,172,0.3);
            }

        /* ── WHY US ── */
        .why-section {
            padding: 100px 0;
            background: var(--off-white);
        }

        .why-card {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            padding: 24px;
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: 12px;
            margin-bottom: 18px;
            transition: all 0.25s;
        }

            .why-card:hover {
                border-color: var(--mint);
                box-shadow: 0 8px 24px rgba(13,115,119,0.09);
            }

        .why-icon {
            width: 48px;
            height: 48px;
            background: var(--mint-pale);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: var(--teal);
            flex-shrink: 0;
        }

        .why-card h6 {
            font-family: 'Playfair Display', serif;
            font-size: 1.05rem;
            color: var(--text-dark);
            margin-bottom: 5px;
        }

        .why-card p {
            font-size: 0.87rem;
            color: var(--gray);
            line-height: 1.65;
            margin: 0;
        }

        /* ── TESTIMONIALS ── */
        .testimonials-section {
            padding: 100px 0;
            background: #EAF7F7;
        }

        .testimonial-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            height: 100%;
        }

        .stars {
            color: var(--teal);
            font-size: 0.9rem;
            margin-bottom: 14px;
        }

        .testimonial-text {
            font-size: 0.92rem;
            color: var(--text-mid);
            line-height: 1.75;
            font-style: italic;
            margin-bottom: 22px;
        }

        .testimonial-author {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .author-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--white);
            flex-shrink: 0;
        }

        .author-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-dark);
        }

        .author-role {
            font-size: 0.77rem;
            color: var(--gray);
        }

        /* ── CTA ── */
        .cta-section {
            padding: 90px 0;
            background: linear-gradient(135deg, var(--teal-dark) 0%, var(--teal-deeper) 100%);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .cta-section::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at center, rgba(20,189,172,0.15) 0%, transparent 70%);
            }

            .cta-section h2 {
                color: var(--white);
                margin-bottom: 14px;
                font-size: clamp(1.8rem, 3vw, 2.5rem);
            }

            .cta-section p {
                color: rgba(255,255,255,0.55);
                font-size: 1rem;
                margin-bottom: 36px;
            }

        /* ── FOOTER ── */
        footer {
            background: var(--teal-deeper);
            padding: 70px 0 30px;
            border-top: 2px solid rgba(20,189,172,0.2);
        }

        .footer-brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            color: var(--mint-light);
            font-weight: 900;
        }

        .footer-desc {
            font-size: 0.87rem;
            color: rgba(255,255,255,0.4);
            line-height: 1.7;
            margin-top: 12px;
        }

        footer h6 {
            color: var(--white);
            font-weight: 600;
            font-size: 0.83rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .footer-link {
            display: block;
            color: rgba(255,255,255,0.38);
            font-size: 0.87rem;
            text-decoration: none;
            padding: 4px 0;
            transition: color 0.2s;
        }

            .footer-link:hover {
                color: var(--mint-light);
            }

        .footer-contact-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
        }

            .footer-contact-item i {
                color: var(--mint);
                font-size: 0.95rem;
                margin-top: 2px;
            }

            .footer-contact-item span {
                font-size: 0.87rem;
                color: rgba(255,255,255,0.45);
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.07);
            margin-top: 48px;
            padding-top: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

            .footer-bottom p {
                margin: 0;
                font-size: 0.82rem;
                color: rgba(255,255,255,0.28);
            }

            .footer-bottom a {
                color: var(--mint-light);
                text-decoration: none;
            }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--teal-deeper);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--mint);
            border-radius: 3px;
        }

        @@media (max-width: 768px) {
            .hero {
                padding: 80px 0;
                min-height: auto;
            }

            .hero-visual {
                margin-top: 46px;
            }
        }

        footer {
            padding: 3rem 5%;
            background: #var(--teal-deeper);
            ;
            border-top: 1px solid rgba(234, 179, 55, 0.1);
            text-align: center;
            color: #a0aec0;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        body.purple-theme footer {
            background: #0a0e27;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer-brand {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="https://bkinfotech.net/">
                <img src="~/CompanyLogos/bk-infotech.png" alt="BK-InfoTech Logo" />
                <div class="brand-text">
                    <span class="brand-name">ePharmacy</span>
                    <span class="brand-sub" style="text-transform:none;">by BK-InfoTech</span>
                </div>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" style="color:var(--mint)">
                <i class="bi bi-list fs-4"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-1 py-3 py-lg-0">
                    <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
