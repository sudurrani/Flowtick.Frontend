<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flowtick - Modern Project Management</title>
    <style>
        :root {
            --primary-color: #0d9488;
            --primary-btn-bg: #0d9488;
            --primary-btn-fore: #fff;
            --primary-hover: #0f766e;
            --border-color: #e5e7eb;
            --primary-gradient: linear-gradient(135deg,
                    #0d9488 0%,
                    #14b8a6 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #1a1410;
            color: #fff;
            overflow-x: hidden;
            transition: background 0.3s ease;
        }

        body.purple-theme {
            background: #0a0e27;
        }

        .nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: rgba(26, 20, 16, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(234, 179, 55, 0.1);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        body.purple-theme .nav {
            background: rgba(10, 14, 39, 0.8);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

        body.purple-theme .logo {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .theme-toggle {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(234, 179, 55, 0.3);
            border-radius: 50px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #fff;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        body.purple-theme .theme-toggle {
            border-color: rgba(102, 126, 234, 0.3);
        }

        .theme-toggle:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .theme-icon {
            font-size: 1.2rem;
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
            padding-bottom: 5px;
        }

        .nav-links a:hover {
            color: var(--primary-hover);
        }

        body.purple-theme .nav-links a:hover {
            color: #667eea;
        }

        .nav-links a.active {
            color: var(--primary-color);
        }

        body.purple-theme .nav-links a.active {
            color: #667eea;
        }

        .nav-links a.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary-gradient);
            animation: slideIn 0.3s ease-out;
        }

        body.purple-theme .nav-links a.active::after {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        @@keyframes slideIn {
            from {
                width: 0;
            }

            to {
                width: 100%;
            }
        }

        .cta-btn {
            padding: 0.8rem 2rem;
            background: var(--primary-gradient);
            border: none;
            border-radius: 50px;
            color: var(--primary-btn-fore);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(2, 142, 114, 0.4);
        }

        body.purple-theme .cta-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(2, 142, 114, 0.4);
        }

        body.purple-theme .cta-btn:hover {
            box-shadow: 0 6px 25px rgba(102, 126, 234, 0.6);
        }

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8rem 5% 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(234, 179, 55, 0.2) 0%, transparent 70%);
            top: -200px;
            right: -200px;
            animation: pulse 8s ease-in-out infinite;
            transition: background 0.3s ease;
        }

        body.purple-theme .hero::before {
            background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 70%);
        }

        @@keyframes pulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.2);
                opacity: 0.8;
            }
        }

        .hero-content {
            max-width: 1200px;
            text-align: center;
            z-index: 1;
        }

        h1 {
            font-size: 4.5rem;
            margin-bottom: 1.5rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: fadeInUp 0.8s ease-out;
            transition: all 0.3s ease;
        }

        body.purple-theme h1 {
            background: linear-gradient(135deg, #fff 0%, #667eea 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .subtitle {
            font-size: 1.5rem;
            color: var(--primary-btn-fore);
            margin-bottom: 3rem;
            animation: fadeInUp 0.8s ease-out 0.2s backwards;
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            animation: fadeInUp 0.8s ease-out 0.4s backwards;
        }

        .primary-btn,
        .secondary-btn {
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
        }

        .primary-btn {
            background: var(--primary-gradient);
            color: var(--primary-btn-fore);
            box-shadow: 0 6px 25px rgba(2, 142, 114, 0.4);
        }

        body.purple-theme .primary-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 6px 25px rgba(102, 126, 234, 0.4);
        }

        .primary-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 35px rgba(2, 142, 114, 0.4);
        }

        body.purple-theme .primary-btn:hover {
            box-shadow: 0 8px 35px rgba(102, 126, 234, 0.6);
        }

        .secondary-btn {
            background: transparent;
            color: #fff;
            border: 2px solid var(--border-color);
        }

        body.purple-theme .secondary-btn {
            border: 2px solid #667eea;
        }

        .secondary-btn:hover {
            background: var(--primary-gradient);
            transform: translateY(-3px);
        }

        body.purple-theme .secondary-btn:hover {
            background: rgba(102, 126, 234, 0.1);
        }

        .features {
            padding: 6rem 5%;
            background: linear-gradient(180deg, #1a1410 0%, #2d2318 100%);
            transition: background 0.3s ease;
        }

        body.purple-theme .features {
            background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
        }

        .section-title {
            text-align: center;
            font-size: 3rem;
            margin-bottom: 4rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

        body.purple-theme .section-title {
            background: linear-gradient(135deg, #fff 0%, #667eea 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 2.5rem;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s;
            backdrop-filter: blur(10px);
        }

        .feature-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--primary-color);
            box-shadow: 0 15px 40px rgba(2, 116, 78, 0.3);
        }

        body.purple-theme .feature-card:hover {
            border-color: #667eea;
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.3);
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            background: var(--primary-gradient);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

        body.purple-theme .feature-icon {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .feature-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--primary-btn-fore);
        }

        .feature-card p {
            color: #a0aec0;
            line-height: 1.6;
        }

        .pricing {
            padding: 6rem 5%;
            background: #1a1410;
            transition: background 0.3s ease;
        }

        body.purple-theme .pricing {
            background: #0a0e27;
        }

        .pricing-subtitle {
            text-align: center;
            color: #a0aec0;
            font-size: 1.2rem;
            margin-top: -2rem;
            margin-bottom: 4rem;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .pricing-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 2.5rem;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s;
            backdrop-filter: blur(10px);
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .pricing-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--primary-color);
            box-shadow: 0 15px 40px rgba(1, 153, 127, 0.3);
        }

        body.purple-theme .pricing-card:hover {
            border-color: #667eea;
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.3);
        }

        .pricing-card.popular {
            border-color: var(--primary-color);
            background: rgba(234, 179, 55, 0.05);
            transform: scale(1.05);
        }

        body.purple-theme .pricing-card.popular {
            border-color: #667eea;
            background: rgba(102, 126, 234, 0.05);
        }

        .pricing-card.popular:hover {
            transform: scale(1.05) translateY(-10px);
        }

        .popular-badge {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary-gradient);
            padding: 0.5rem 1.5rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--primary-btn-fore);
            box-shadow: 0 4px 15px rgba(2, 142, 114, 0.4);
            transition: all 0.3s ease;
        }

        body.purple-theme .popular-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.5);
        }

        .plan-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .plan-header h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #fff;
        }

        .price {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            margin-bottom: 0.5rem;
        }

        .currency {
            font-size: 1.5rem;
            color: var(--primary-color);
            margin-top: 0.5rem;
            transition: color 0.3s ease;
        }

        body.purple-theme .currency {
            color: #667eea;
        }

        .amount {
            font-size: 4rem;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }

        .amount-custom {
            font-size: 2.5rem;
            font-weight: 700;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

        body.purple-theme .amount-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .period {
            font-size: 1rem;
            color: #a0aec0;
            align-self: flex-end;
            margin-bottom: 0.8rem;
        }

        .plan-desc {
            color: #a0aec0;
            font-size: 1rem;
        }

        .features-list {
            list-style: none;
            margin-bottom: 2rem;
            flex-grow: 1;
        }

        .features-list li {
            padding: 0.75rem 0;
            color: #a0aec0;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
             transition: color 0.3s ease;
        }
        .features-list li:hover{            
            font-size: 0.98rem;
            color: var(--primary-color);               
        }

        .features-list li:last-child {
            border-bottom: none;
        }

        .plan-btn {
            width: 100%;
            padding: 1rem;
            background: var(--primary-btn-fore);
            border: 2px solid var(--primary-color);
            border-radius: 50px;
            color: var(--primary-color);
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        body.purple-theme .plan-btn {
            background: rgba(102, 126, 234, 0.1);
            border: 2px solid #667eea;
        }

        .plan-btn:hover {
            background: var(--primary-gradient);
            transform: translateY(-2px);
            color: var(--primary-btn-fore);
        }

        body.purple-theme .plan-btn:hover {
            background: rgba(102, 126, 234, 0.2);
        }

        .plan-btn.primary {
            background: var(--primary-gradient);
            border: none;
            color: var(--primary-btn-fore);
            box-shadow: 0 4px 15px rgba(1, 145, 123, 0.4);
        }

        body.purple-theme .plan-btn.primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .plan-btn.primary:hover {
            box-shadow: 0 6px 25px rgba(2, 127, 85, 0.6);
        }

        body.purple-theme .plan-btn.primary:hover {
            box-shadow: 0 6px 25px rgba(102, 126, 234, 0.6);
        }

        .stats {
            padding: 6rem 5%;
            background: linear-gradient(180deg, #1a1410 0%, #2d2318 100%);
            transition: background 0.3s ease;
        }

        body.purple-theme .stats {
            background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 3rem;
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        .stat-item h2 {
            font-size: 3.5rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            transition: all 0.3s ease;
        }

        body.purple-theme .stat-item h2 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-item p {
            color: var(--primary-btn-fore);
            font-size: 1.1rem;
        }

        .about {
            padding: 6rem 5%;
            background: linear-gradient(180deg, #2d2318 0%, #1a1410 100%);
            transition: background 0.3s ease;
        }

        body.purple-theme .about {
            background: linear-gradient(180deg, #1a1f3a 0%, #0a0e27 100%);
        }

        .about-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .about-content {
            color: #fff;
        }

        .about-intro {
            text-align: center;
            font-size: 1.4rem;
            color: #a0aec0;
            margin-bottom: 4rem;
            line-height: 1.8;
        }

        .about-story {
            margin-bottom: 4rem;
            padding: 2.5rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .about-story h3 {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            background: var(--primary-btn-fore);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

        .about-story:hover {
            color: var(--primary-color);
        }

        body.purple-theme .about-story h3 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .about-story p {
            color: #a0aec0;
            line-height: 1.8;
            font-size: 1.1rem;
            margin-bottom: 1.2rem;
        }

        .about-story p:last-child {
            margin-bottom: 0;
        }

        .mission-vision {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .mission-card {
            padding: 2.5rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s;
        }

        .mission-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--primary-color);
            box-shadow: 0 15px 40px rgba(1, 125, 94, 0.3);
        }

        body.purple-theme .mission-card:hover {
            border-color: #667eea;
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.3);
        }

        .mission-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .mission-card h3 {
            font-size: 1.6rem;
            margin-bottom: 1rem;
            color: var(--primary-btn-fore);
            transition: color 0.3s ease;
        }

        .mission-card:hover h3 {
            color: var(--primary-color);
        }

        .mission-card p {
            color: #a0aec0;
            line-height: 1.7;
            font-size: 1.05rem;
        }

        .values {
            margin-bottom: 4rem;
        }

        .values h3 {
            font-size: 2rem;
            margin-bottom: 2rem;
            text-align: center;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

        body.purple-theme .values h3 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .values-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 2rem;
        }

        .value-item {
            padding: 2rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .value-item:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--primary-color);
            transform: translateY(-5px);
        }

        body.purple-theme .value-item:hover {
            border-color: #667eea;
        }

        .value-item strong {
            display: block;
            font-size: 1.2rem;
            margin-bottom: 0.8rem;
            color: var(--primary-btn-fore);
            transition: color 0.3s ease;
        }
        .value-item:hover strong {            
            color: var(--primary-color);
        }

        .value-item p {
            color: #a0aec0;
            line-height: 1.6;
            font-size: 0.95rem;
        }

        .team-cta {
            text-align: center;
            padding: 3rem;
            background: rgba(2, 132, 121, 0.05);
            border-radius: 20px;
            border: 1px solid var(--primary-color);
            transition: all 0.3s ease;
        }

        body.purple-theme .team-cta {
            background: rgba(102, 126, 234, 0.05);
            border: 1px solid rgba(102, 126, 234, 0.2);
        }

        .team-cta h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
            color: #fff;
        }

        .team-cta p {
            color: #a0aec0;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .cta-section {
            padding: 8rem 5%;
            text-align: center;
            background: linear-gradient(180deg, #101a18 0%, #2d2318 100%);
            transition: background 0.3s ease;
        }

        body.purple-theme .cta-section {
            background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
        }

        .cta-section h2 {
            font-size: 3rem;
            margin-bottom: 1.5rem;
        }

        .cta-section p {
            font-size: 1.3rem;
            color: #a0aec0;
            margin-bottom: 3rem;
        }

        footer {
            padding: 3rem 5%;
