@{
    int activeTeam = 515;
    int completedProject = 3;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Flowtick – Project & Task Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />    
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />    
    <link href="/lib/bootstrap/dist/css/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #0d9488;
            --primary-btn-bg: #0d9488;
            --primary-btn-fore: #fff;
            --primary-hover: #0f766e;
            --border-color: #e5e7eb;
            --dark: #0f172a;
            --dark2: #1e293b;
            --muted: #64748b;
            --light-bg: #f8fafc;
            --card-bg: #fff;
            --radius: 14px;
            --shadow: 0 4px 24px rgba(13,148,136,.10);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
            color: var(--dark);
            background: #fff;
            overflow-x: hidden;
        }
        /* ─── NAV ─── */
        .navbar {
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            padding: 0 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 1px 8px rgba(0,0,0,.06);
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.45rem;
            color: var(--primary-color) !important;
            letter-spacing: -0.5px;
        }

            .navbar-brand span {
                color: var(--dark)
            }

        .nav-link {
            font-weight: 500;
            color: var(--dark) !important;
            font-size: .93rem;
            padding: .5rem .85rem !important;
            transition: color .2s
        }

            .nav-link:hover {
                color: var(--primary-color) !important
            }

        .btn-primary-ft {
            background: var(--primary-btn-bg);
            color: var(--primary-btn-fore);
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: .92rem;
            padding: .5rem 1.25rem;
            transition: background .2s,transform .15s;
        }

            .btn-primary-ft:hover {
                background: var(--primary-hover);
                color: #fff;
                transform: translateY(-1px)
            }

        .btn-outline-ft {
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 8px;
            font-weight: 600;
            font-size: .92rem;
            padding: .45rem 1.2rem;
            transition: all .2s;
        }

            .btn-outline-ft:hover {
                background: var(--primary-color);
                color: #fff
            }

        /* ─── HERO ─── */
        .hero {
            background: linear-gradient(135deg,#f0fdfa 0%,#ccfbf1 40%,#e0f2fe 100%);
            padding: 90px 0 70px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                top: -120px;
                right: -120px;
                width: 520px;
                height: 520px;
                background: radial-gradient(circle,rgba(13,148,136,.13) 0%,transparent 70%);
                border-radius: 50%;
                pointer-events: none;
            }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(13,148,136,.12);
            color: var(--primary-color);
            border-radius: 50px;
            padding: 5px 16px;
            font-size: .82rem;
            font-weight: 600;
            border: 1px solid rgba(13,148,136,.25);
            margin-bottom: 1.3rem;
        }

        .hero h1 {
            font-size: clamp(2.2rem,5vw,3.6rem);
            font-weight: 800;
            line-height: 1.12;
            letter-spacing: -1.5px;
            color: var(--dark);
        }

            .hero h1 .accent {
                color: var(--primary-color)
            }

        .hero p.lead {
            color: var(--muted);
            font-size: 1.13rem;
            line-height: 1.7;
            max-width: 560px
        }

        .hero-btns {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 2rem
        }

        .btn-lg-ft {
            padding: .75rem 2rem !important;
            font-size: 1rem !important;
            border-radius: 10px !important
        }

        .hero-stats {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 2.5rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(13,148,136,.2);
        }

        .hero-stat strong {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary-color)
        }

        .hero-stat span {
            font-size: .82rem;
            color: var(--muted);
            display: block;
            font-weight: 500
        }

        /* ─── HERO MOCKUP ─── */
        .hero-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 24px 64px rgba(13,148,136,.18),0 2px 8px rgba(0,0,0,.08);
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .hero-card-header {
            background: linear-gradient(90deg,var(--primary-color),#0891b2);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .hero-card-header .dots {
                display: flex;
                gap: 6px
            }

            .hero-card-header .dot {
                width: 11px;
                height: 11px;
                border-radius: 50%;
                background: rgba(255,255,255,.4)
            }

                .hero-card-header .dot.red {
                    background: #ff5f57
                }

                .hero-card-header .dot.yellow {
                    background: #febc2e
                }

                .hero-card-header .dot.green {
                    background: #28c840
                }

            .hero-card-header span {
                color: rgba(255,255,255,.9);
                font-size: .85rem;
                font-weight: 600;
                margin-left: 6px
            }

        .kanban-wrap {
            padding: 16px;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 10px
        }

        .kanban-col {
            background: #f8fafc;
            border-radius: 10px;
            padding: 10px
        }

        .k-col-title {
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            margin-bottom: 8px;
            padding: 0 2px
        }

            .k-col-title.todo {
                color: #64748b
            }

            .k-col-title.inprogress {
                color: #0d9488
            }

            .k-col-title.review {
                color: #d97706
            }

            .k-col-title.done {
                color: #16a34a
            }

        .k-card {
            background: #fff;
            border-radius: 8px;
            padding: 9px 10px;
            margin-bottom: 7px;
            box-shadow: 0 1px 4px rgba(0,0,0,.07);
            border: 1px solid var(--border-color);
            font-size: .75rem
        }

        .k-card-title {
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 5px;
            font-size: .78rem
        }

        .k-tag {
            display: inline-block;
            border-radius: 4px;
            padding: 2px 7px;
            font-size: .65rem;
            font-weight: 600;
            margin-bottom: 5px
        }

            .k-tag.design {
                background: #e0f2fe;
                color: #0369a1
            }

            .k-tag.dev {
                background: #dcfce7;
                color: #166534
            }

            .k-tag.bug {
                background: #fee2e2;
                color: #991b1b
            }

            .k-tag.review {
                background: #fef3c7;
                color: #92400e
            }

        .k-avatar-row {
            display: flex;
            gap: -4px;
            margin-top: 4px
        }

        .k-avatar {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid #fff;
            font-size: .55rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff
        }

        /* ─── SECTIONS ─── */
        section {
            padding: 80px 0
        }

        .section-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(13,148,136,.09);
            color: var(--primary-color);
            border-radius: 50px;
            padding: 4px 14px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: .9rem;
        }

        .section-title {
            font-size: clamp(1.7rem,3.5vw,2.5rem);
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1.18;
            color: var(--dark)
        }

        .section-sub {
            color: var(--muted);
            font-size: 1rem;
            line-height: 1.65;
            max-width: 600px
        }

        /* ─── STATS ─── */
        .stats-section {
            background: var(--primary-color);
            padding: 56px 0
        }

        .stat-item {
            text-align: center
        }

            .stat-item strong {
                font-size: clamp(2rem,4vw,2.8rem);
                font-weight: 800;
                color: #fff;
                display: block;
                letter-spacing: -1px
            }

            .stat-item span {
                color: rgba(255,255,255,.8);
                font-size: .9rem;
                font-weight: 500
            }

        .stat-divider {
            width: 1px;
            background: rgba(255,255,255,.2);
            height: 60px;
            align-self: center
        }

        /* ─── FEATURES ─── */
        .features-section {
            background: var(--light-bg)
        }

        .feature-card {
            background: #fff;
            border-radius: var(--radius);
            padding: 28px 26px;
            border: 1px solid var(--border-color);
            transition: box-shadow .25s,transform .25s;
            height: 100%;
        }

            .feature-card:hover {
                box-shadow: var(--shadow);
                transform: translateY(-4px)
            }

        .feature-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: rgba(13,148,136,.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 1.1rem;
        }

        .feature-card h5 {
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: .5rem
        }

        .feature-card p {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.6;
            margin: 0
        }

        /* ─── HOW IT WORKS ─── */
        .step-number {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--primary-color);
            color: #fff;
            font-weight: 800;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .step-connector {
            width: 2px;
            background: linear-gradient(var(--primary-color),rgba(13,148,136,.1));
            flex: 1;
            min-height: 36px;
            margin-left: 21px
        }

        .step-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 22px 22px
        }

            .step-card h5 {
                font-weight: 700;
                margin-bottom: .35rem
            }

            .step-card p {
                color: var(--muted);
                font-size: .9rem;
                margin: 0
            }

        /* ─── PRICING ─── */
        .pricing-section {
            background: var(--light-bg)
        }

        .price-card {
            background: #fff;
            border-radius: var(--radius);
            padding: 34px 30px;
            border: 2px solid var(--border-color);
            height: 100%;
            transition: box-shadow .25s,transform .25s,border-color .25s;
            position: relative;
        }

            .price-card:hover {
                box-shadow: var(--shadow);
                transform: translateY(-4px)
            }

            .price-card.popular {
                border-color: var(--primary-color);
                box-shadow: 0 8px 32px rgba(13,148,136,.18)
            }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary-color);
            color: #fff;
            border-radius: 50px;
            padding: 4px 18px;
            font-size: .75rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .price-name {
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--dark);
            margin-bottom: .3rem
        }

        .price-amount {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--primary-color);
            letter-spacing: -1px;
            line-height: 1
        }

            .price-amount sup {
                font-size: 1.1rem;
                vertical-align: super;
                margin-right: 2px
            }

            .price-amount .mo {
                font-size: .85rem;
                color: var(--muted);
                font-weight: 500
            }

        .price-desc {
            color: var(--muted);
            font-size: .84rem;
            margin: .6rem 0 1.3rem
        }

        .price-feature {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-bottom: .55rem;
            font-size: .88rem;
            color: var(--dark)
        }

            .price-feature i {
                color: var(--primary-color);
                font-size: .95rem;
                flex-shrink: 0;
                margin-top: 1px
            }

        .price-divider {
            border-color: var(--border-color);
            margin: 1.3rem 0
        }

        /* ─── STORY ─── */
        .story-section {
            background: #fff
        }

        .story-img {
            background: linear-gradient(135deg,#f0fdfa,#ccfbf1);
            border-radius: 20px;
            padding: 40px 30px;
            border: 1px solid rgba(13,148,136,.2);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .story-quote {
            background: #fff;
            border-radius: 12px;
            padding: 22px;
            border-left: 4px solid var(--primary-color);
            box-shadow: 0 2px 12px rgba(13,148,136,.1);
            font-size: .95rem;
            color: var(--dark2);
            line-height: 1.65;
            font-style: italic;
        }

        .story-person {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 10px
        }

        .story-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--primary-color);
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem
        }

        .story-person-info strong {
            font-size: .9rem;
            font-weight: 700;
            display: block
        }

        .story-person-info span {
            font-size: .78rem;
            color: var(--muted)
        }

        .vision-mission-card {
            background: var(--light-bg);
            border-radius: var(--radius);
            padding: 26px 24px;
            border: 1px solid var(--border-color);
            margin-bottom: 1rem;
        }

            .vision-mission-card h5 {
                font-weight: 700;
                font-size: 1rem;
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: .5rem;
                color: var(--primary-color)
            }

            .vision-mission-card p {
                color: var(--dark2);
                font-size: .92rem;
                line-height: 1.65;
                margin: 0
            }

        /* ─── TESTIMONIALS ─── */
        .testimonials-section {
            background: var(--light-bg)
        }

        .testi-card {
            background: #fff;
            border-radius: var(--radius);
            padding: 26px 24px;
            border: 1px solid var(--border-color);
            height: 100%;
        }

        .stars {
            color: #f59e0b;
            font-size: .9rem;
            margin-bottom: .7rem
        }

        .testi-card p {
            font-size: .92rem;
            color: var(--dark2);
            line-height: 1.65;
            margin-bottom: 1rem;
            font-style: italic
        }

        .testi-author {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .testi-av {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--primary-color);
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            flex-shrink: 0
        }

        .testi-author strong {
            font-size: .88rem;
            display: block;
            font-weight: 700
        }

        .testi-author span {
            font-size: .78rem;
            color: var(--muted)
        }

        /* ─── CTA ─── */
        .cta-section {
            background: linear-gradient(135deg,var(--primary-color) 0%,#0891b2 100%);
            padding: 80px 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .cta-section::before {
                content: '';
                position: absolute;
                top: -80px;
                left: -80px;
                width: 350px;
                height: 350px;
                background: rgba(255,255,255,.06);
                border-radius: 50%;
            }

            .cta-section::after {
                content: '';
                position: absolute;
                bottom: -80px;
                right: -80px;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,.06);
                border-radius: 50%;
            }

            .cta-section h2 {
                font-weight: 800;
                font-size: clamp(1.8rem,4vw,2.8rem);
                color: #fff;
                letter-spacing: -1px;
                margin-bottom: 1rem
            }

            .cta-section p {
                color: rgba(255,255,255,.85);
                font-size: 1.05rem;
                max-width: 520px;
                margin: 0 auto 2rem
            }

        .btn-white {
            background: #fff;
            color: var(--primary-color);
            border: none;
            border-radius: 10px;
            font-weight: 700;
            padding: .75rem 2.2rem;
            font-size: 1rem;
            transition: all .2s
        }

            .btn-white:hover {
                background: #f0fdfa;
                color: var(--primary-hover);
                transform: translateY(-2px)
            }

        .btn-outline-white {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255,255,255,.6);
            border-radius: 10px;
            font-weight: 600;
            padding: .72rem 2rem;
            font-size: 1rem;
            transition: all .2s
        }

            .btn-outline-white:hover {
                background: rgba(255,255,255,.15);
                border-color: #fff
            }

        /* ─── FOOTER ─── */
        footer {
            background: var(--dark);
            color: #94a3b8;
            padding: 60px 0 30px
        }

        .footer-brand {
            font-size: 1.4rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .5rem
        }

            .footer-brand span {
                color: var(--primary-color)
            }

        .footer-desc {
            font-size: .88rem;
            line-height: 1.6;
            max-width: 260px;
            color: #64748b
        }

        .footer-heading {
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: #fff;
            margin-bottom: 1rem
        }

        .footer-link {
            display: block;
            color: #64748b;
            font-size: .88rem;
            text-decoration: none;
            margin-bottom: .45rem;
            transition: color .2s
        }

            .footer-link:hover {
                color: var(--primary-color)
            }

        .footer-bottom {
            border-top: 1px solid #1e293b;
            padding-top: 1.5rem;
            margin-top: 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px
        }

            .footer-bottom span {
                font-size: .82rem
            }

        .social-links {
            display: flex;
            gap: 10px
        }

        .social-link {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #1e293b;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
            text-decoration: none;
            transition: all .2s
        }

            .social-link:hover {
                background: var(--primary-color);
                color: #fff
            }
        /* ─── RESPONSIVE ─── */
        @@media(max-width:768px) {
            .kanban-wrap {
                grid-template-columns: repeat(2,1fr)
            }

            .hero-stats {
                gap: 1.3rem
            }

            .stat-divider {
                display: none
            }

            section {
                padding: 56px 0
            }
        }

        @@media(max-width:480px) {
            .kanban-wrap {
                grid-template-columns: 1fr 1fr
            }

            .hero-btns {
                flex-direction: column
            }

                .hero-btns .btn-lg-ft {
                    width: 100%;
                    text-align: center
                }
        }
        /* ─── ANIMATIONS ─── */
        @@keyframes float {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-8px)
            }
        }

        .hero-card-wrap {
            animation: float 5s ease-in-out infinite
        }
    </style>

   
</head>
<body>

    <!-- ════════════ NAVBAR ════════════ -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">Flow<span>tick</span></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1 py-3 py-lg-0">
                    <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="#how-it-works">How It Works</a></li>
                    <li class="nav-item"><a class="nav-link" href="#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="#story">Our Story</a></li>
                    <li class="nav-item ms-lg-2"><a class="btn btn-outline-ft" onclick="redirectToAction('/Auth/Login?key=',1000,'_blank');">Log In</a></li>
